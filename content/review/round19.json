   "passed": true,
   "rows": [
    {
     "kind": "main",
     "text": "旅客收到航班延誤通知時，不想研究票務規則，只想知道：「我還趕得上轉機嗎？不行的話，下一個可行選項是什麼？」準備買車的人更在意哪一台符合家庭、預算和保養成本，而不是從規格表開始。",
     "jev": {
      "faithful": 0.92,
      "overclaim": 0.17,
      "complete": 0.73,
      "fluency": {
