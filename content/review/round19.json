       "conf": 0.34
      }
     },
     "reasons": [],
     "pages": [
      138
     ]
    },
    {
     "kind": "main",
     "text": "第二個節點在評估層：顧客陷入糾結時，主動重組複雜方案，提供客觀的下一個最佳選項。",
     "jev": {
      "faithful": 0.93,
      "overclaim": 0.13,
      "complete": 0.64,
      "fluency": {
       "score": 2.21,
       "conf": 0.48
      }
     },
     "reasons": [],
     "pages": [
      138
     ]
    },
    {
     "kind": "main",
     "text": "第三個節點在信任層：在交易或變更的關鍵點，給予明確的承諾或風險說明，讓顧客有安全感。",
     "jev": {
      "faithful": 0.86,
      "overclaim": 0.19,
      "complete": 0.86,
      "fluency": {
       "score": 2.29,
       "conf": 0.48
      }
