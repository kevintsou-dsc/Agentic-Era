{
  "name": "agentic-era",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run verify && astro build && node scripts/verify/check-links.mjs",
    "verify": "node scripts/verify/verify-quotes.mjs && node scripts/verify/verify-meta.mjs && node scripts/verify/lint-stories.mjs && node scripts/verify/lint-style.mjs && node scripts/verify/check-fonts.mjs",
    "verify:release": "node scripts/verify/verify-release.mjs",
    "story:inventory": "node scripts/extract/inventory.mjs",
    "story:check": "node scripts/verify/story-check.mjs",
    "review:packet": "node scripts/review/packet.mjs",
    "og": "node scripts/og.mjs",
    "fonts": "python scripts/fonts/fonts.py",
    "preview": "astro preview",
    "check:repo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-repo.ps1"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "astro": "5.18.2",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
