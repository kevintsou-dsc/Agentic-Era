---
// a15 p.140「四個關鍵地基」：照原文用詞畫成一棟「生成式體驗」蓋在四塊地基石上。
// 第 1 段主文（買車例子）：房子浮在半空、微微歪斜；第 2 段：四塊地基依序墊入，房子落座回正。
// 彩蛋：滑過（觸控點一下、鍵盤 Tab）任一塊地基，它會下沉、房子往那一側傾斜、牆面裂開，
// 並在下方浮出「缺了這塊」的後果與原文金句；移開後慢慢回正。傾斜與裂縫用 :has() 純 CSS 完成。
// 後果金句照錄原文（逐字比對登記在 a15 場景的 src）。class 一律加 fd- 前綴。
const stones = [
  { a: '資料的', b: '透明度', tilt: -5, miss: 'AI 讀得到，卻講不清楚', quote: 'AI 即使讀得到資料，也可能無法正確整理重點', page: 139 },
  { a: '流程的', b: '銜接力', tilt: -2.5, miss: '服務一段一段斷開', quote: '顧客感受到的仍可能是一段段無法銜接的服務', page: 139 },
  { a: '規則的', b: '一致性', tilt: 2.5, miss: '換個管道，答案就變', quote: '每換一個管道就要重新說明、重新確認，甚至得到不一致的答案', page: 139 },
  { a: '責任的', b: '可追蹤性', tilt: 5, miss: '出了錯，沒人說得清', quote: '如果建議錯了，責任由誰承擔？', page: 142 },
];
---
<div class="fd">
  <div class="fd-settle" data-at="2" aria-hidden="true">
    <svg class="fd-house" data-at="1" viewBox="0 0 320 190">
      <rect class="fd-chimney" x="222" y="26" width="22" height="40" />
      <polygon class="fd-roof" points="8,94 160,18 312,94" />
      <path class="fd-tiles" d="M106 45 H214 M72 62 H248 M40 78 H280" />
      <rect class="fd-wall" x="34" y="94" width="252" height="94" />
      <g class="fd-win"><rect x="54" y="112" width="48" height="38" rx="2" /><path d="M78 112 V150 M54 131 H102" /></g>
      <g class="fd-win"><rect x="218" y="112" width="48" height="38" rx="2" /><path d="M242 112 V150 M218 131 H266" /></g>
      <rect class="fd-sign" x="110" y="104" width="100" height="24" rx="4" />
      <text class="fd-name" x="160" y="121">生成式體驗</text>
      <path class="fd-door" d="M144 188 V154 a16 16 0 0 1 32 0 V188" />
      <circle class="fd-knob" cx="170" cy="170" r="2" />
      <path class="fd-crack fd-crack-l" pathLength="1" d="M88 188 l-6 -18 l10 -12 l-8 -16 l5 -12" />
      <path class="fd-crack fd-crack-r" pathLength="1" d="M232 188 l6 -18 l-10 -12 l8 -16 l-5 -12" />
    </svg>
  </div>
  <ol class="fd-stones" aria-label="生成式體驗的四個關鍵地基">
    {stones.map((s, i) => (
      <li class="fd-stone" data-at="2" tabindex="0" style={`--d:${i * 140}ms`}>
        <span class="fd-a">{s.a}</span><b>{s.b}</b>
        <span class="fd-tip" role="tooltip">
          <em>缺了這塊</em>
          <strong>{s.miss}</strong>
          <q>{s.quote}</q>
          <small>原文 p.{s.page}</small>
        </span>
      </li>
    ))}
  </ol>
  <span class="fd-ground" aria-hidden="true"></span>
  <p class="fd-hint" data-at="2" aria-hidden="true"><span class="fd-hover">滑過</span><span class="fd-tap">點</span>任一塊地基，看看缺了它會怎樣</p>
</div>

<style define:vars={{ t1: `${stones[0].tilt}deg`, t2: `${stones[1].tilt}deg`, t3: `${stones[2].tilt}deg`, t4: `${stones[3].tilt}deg` }}>
  .fd { --tilt: 0deg; --w: min(86%, 380px); --stone: color-mix(in srgb, var(--ink) 9%, var(--paper)); position: relative; display: grid; justify-items: center; padding: 6px 0 4px; }
  .fd:has(.fd-stone:nth-child(1):is(:hover, :focus)) { --tilt: var(--t1); }
  .fd:has(.fd-stone:nth-child(2):is(:hover, :focus)) { --tilt: var(--t2); }
  .fd:has(.fd-stone:nth-child(3):is(:hover, :focus)) { --tilt: var(--t3); }
  .fd:has(.fd-stone:nth-child(4):is(:hover, :focus)) { --tilt: var(--t4); }

  /* 外層管落座與傾斜；回正用較長、帶一點回彈的過場 */
  .fd-settle { width: var(--w); transform-origin: 50% 100%;
    transform: translateY(calc((1 - var(--on)) * -26px)) rotate(calc((1 - var(--on)) * -3deg + var(--tilt)));
    transition: transform 1.1s cubic-bezier(.34, 1.4, .64, 1); }
  .fd-house { display: block; width: 100%; height: auto; overflow: visible; opacity: calc(.12 + .88 * var(--on)); transition: opacity .5s;
    stroke: var(--ink); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }
  .fd-roof { fill: var(--accent); }
  .fd-tiles { fill: none; stroke-width: 1.5; opacity: .28; }
  .fd-chimney, .fd-wall, .fd-sign { fill: var(--paper); }
  .fd-sign { stroke-width: 1.5; }
  .fd-win rect { fill: color-mix(in srgb, var(--accent) 30%, var(--paper)); }
  .fd-win path { fill: none; stroke-width: 1.5; }
  .fd-door { fill: color-mix(in srgb, var(--accent) 55%, var(--paper)); }
  .fd-knob { fill: var(--ink); stroke: none; }
  .fd-name { stroke: none; fill: var(--accent-ink); font: 800 15px var(--font-sans); text-anchor: middle; }
  .fd-crack { fill: none; stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset .3s; }
  .fd:has(.fd-stone:is(:nth-child(1), :nth-child(2)):is(:hover, :focus)) .fd-crack-l,
  .fd:has(.fd-stone:is(:nth-child(3), :nth-child(4)):is(:hover, :focus)) .fd-crack-r { stroke-dashoffset: 0; transition: stroke-dashoffset .5s .25s; }

  /* 地基寬度對齊牆面（牆寬占房子 252/320） */
  .fd-stones { list-style: none; margin: 0; padding: 0; width: calc(var(--w) * .79); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 5px; }
  .fd-stone { --sink: 0px; position: relative; display: grid; place-items: center; align-content: center; min-height: 58px; padding: 6px 2px; text-align: center; line-height: 1.3;
    background: var(--stone); border: 2px solid var(--ink); border-radius: 4px; cursor: pointer; outline: none;
    opacity: calc(.12 + .88 * var(--on)); transform: translateY(calc((1 - var(--on)) * 36px + var(--sink)));
    transition: opacity .5s var(--d), transform .5s var(--d), background .3s; }
  .fd-a { font-size: 11px; color: var(--ink-2); }
  .fd-stone b { font-size: clamp(12.5px, .6vw + 9px, 15px); }
  .fd-stone:is(:hover, :focus) { --sink: 12px; z-index: 2; background: color-mix(in srgb, var(--ink) 3%, var(--paper)); border-style: dashed; transition-delay: 0s; }
  .fd-stone:focus-visible { box-shadow: 0 0 0 3px var(--accent-ink); }

  /* 後果浮窗：出現在地基下方，第一、最後一塊靠邊對齊避免超出 */
  .fd-tip { position: absolute; top: calc(100% + 14px); left: 50%; width: min(240px, 62vw); display: grid; gap: 4px; padding: 10px 12px; text-align: left; line-height: 1.55;
    background: var(--paper); border: 1.5px solid var(--ink); border-radius: 8px; box-shadow: 0 8px 22px color-mix(in srgb, var(--ink) 16%, transparent);
    opacity: 0; pointer-events: none; transform: translate(-50%, -6px); transition: opacity .2s, transform .2s; }
  .fd-stone:first-child .fd-tip { left: 0; transform: translate(0, -6px); }
  .fd-stone:last-child .fd-tip { left: auto; right: 0; transform: translate(0, -6px); }
  .fd-stone:is(:hover, :focus) .fd-tip { opacity: 1; transform: translate(-50%, 0); transition: opacity .3s .15s, transform .3s .15s; }
  .fd-stone:first-child:is(:hover, :focus) .fd-tip, .fd-stone:last-child:is(:hover, :focus) .fd-tip { transform: translate(0, 0); }
  .fd-tip em { font-style: normal; font-size: 11px; letter-spacing: .08em; color: var(--ink-3); }
  .fd-tip strong { font-size: 14.5px; color: var(--accent-ink); }
  .fd-tip q { font-size: 12.5px; color: var(--ink-2); quotes: "「" "」"; }
  .fd-tip small { font: 11px var(--font-mono, monospace); color: var(--ink-3); }

  .fd-ground { width: 100%; height: 0; margin-top: 2px; border-top: 2px solid var(--ink); }
  .fd-hint { margin: 6px 0 0; font-size: 12px; color: var(--ink-3); opacity: calc(var(--on) * .9); transition: opacity .5s .6s; }
  .fd:has(.fd-stone:is(:hover, :focus)) .fd-hint { opacity: 0; transition-delay: 0s; }
  .fd-tap { display: none; }
  @media (hover: none) { .fd-hover { display: none; } .fd-tap { display: inline; } }
  @media (prefers-reduced-motion: reduce) { .fd-settle, .fd-house, .fd-stone, .fd-hint, .fd-tip, .fd-crack { transition: none; } }
</style>
