---
// a15 p.140「四個關鍵地基」：照原文用詞畫成一棟「生成式體驗」蓋在四塊地基石上。
// 第 1 段主文（買車例子）：房子浮在半空、微微歪斜；第 2 段：四塊地基依序墊入，房子落座回正。
// 彩蛋：滑過任一塊地基，它會下沉、房子往那一側傾斜，移開後慢慢回正（地基沒整理好，體驗就會歪）。
// 傾斜用 :has() 純 CSS 完成。class 一律加 fd- 前綴。
const stones = [
  { a: '資料的', b: '透明度', tilt: -5 },
  { a: '流程的', b: '銜接力', tilt: -2.5 },
  { a: '規則的', b: '一致性', tilt: 2.5 },
  { a: '責任的', b: '可追蹤性', tilt: 5 },
];
---
<div class="fd" role="img" aria-label={'生成式體驗蓋在四個關鍵地基上：' + stones.map((s) => s.a + s.b).join('、') + '。地基沒整理好，體驗就會傾斜。'}>
  <div class="fd-settle" data-at="2" aria-hidden="true">
    <div class="fd-house" data-at="1">
      <span class="fd-roof"></span>
      <span class="fd-body">
        <span class="fd-win"></span><span class="fd-win"></span>
        <b>生成式體驗</b>
        <span class="fd-door"></span>
      </span>
    </div>
  </div>
  <ol class="fd-stones" aria-hidden="true">
    {stones.map((s, i) => (
      <li class="fd-stone" data-at="2" style={`--d:${i * 140}ms`}><span>{s.a}</span><b>{s.b}</b></li>
    ))}
  </ol>
  <span class="fd-ground" aria-hidden="true"></span>
  <p class="fd-hint" data-at="2" aria-hidden="true">滑過任一塊地基試試</p>
</div>

<style define:vars={{ t1: `${stones[0].tilt}deg`, t2: `${stones[1].tilt}deg`, t3: `${stones[2].tilt}deg`, t4: `${stones[3].tilt}deg` }}>
  .fd { --tilt: 0deg; --stone: color-mix(in srgb, var(--ink) 10%, var(--paper)); position: relative; display: grid; justify-items: center; padding: 8px 0 4px; }
  .fd:has(.fd-stone:nth-child(1):hover) { --tilt: var(--t1); }
  .fd:has(.fd-stone:nth-child(2):hover) { --tilt: var(--t2); }
  .fd:has(.fd-stone:nth-child(3):hover) { --tilt: var(--t3); }
  .fd:has(.fd-stone:nth-child(4):hover) { --tilt: var(--t4); }

  /* 外層管落座與傾斜；回正用較長、帶一點回彈的過場 */
  .fd-settle { width: min(78%, 340px); transform-origin: 50% 100%;
    transform: translateY(calc((1 - var(--on)) * -26px)) rotate(calc((1 - var(--on)) * -3deg + var(--tilt)));
    transition: transform 1.1s cubic-bezier(.34, 1.4, .64, 1); }
  .fd-house { display: grid; opacity: calc(.12 + .88 * var(--on)); transition: opacity .5s; }
  .fd-roof { height: clamp(44px, 7vw, 70px); margin: 0 -6%; background: var(--accent); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .fd-body { position: relative; display: grid; place-items: center; min-height: clamp(84px, 12vw, 120px); background: var(--paper); border: 2px solid var(--ink); border-top: 0; border-radius: 0 0 4px 4px; }
  .fd-body b { font-size: clamp(16px, 1.3vw + 8px, 21px); font-weight: 800; color: var(--accent-ink); }
  .fd-win { position: absolute; top: 14px; width: 16%; aspect-ratio: 4 / 3; border: 2px solid var(--ink); border-radius: 2px; background: color-mix(in srgb, var(--accent) 35%, var(--paper)); }
  .fd-win:first-child { left: 9%; }
  .fd-win:nth-child(2) { right: 9%; }
  .fd-door { position: absolute; bottom: 0; left: 50%; translate: -50% 0; width: 13%; height: 26%; border: 2px solid var(--ink); border-bottom: 0; border-radius: 3px 3px 0 0; }

  .fd-stones { list-style: none; margin: 0; padding: 0; width: min(92%, 400px); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .fd-stone { --sink: 0px; display: grid; place-items: center; align-content: center; min-height: 62px; padding: 6px 2px; text-align: center; line-height: 1.3;
    background: var(--stone); border: 2px solid var(--ink); border-radius: 4px; cursor: default;
    opacity: calc(.12 + .88 * var(--on)); transform: translateY(calc((1 - var(--on)) * 36px + var(--sink)));
    transition: opacity .5s var(--d), transform .5s var(--d), background .3s; }
  .fd-stone span { font-size: 11.5px; color: var(--ink-2); }
  .fd-stone b { font-size: clamp(13px, .6vw + 9px, 15px); }
  .fd-stone:hover { --sink: 12px; background: color-mix(in srgb, var(--ink) 4%, var(--paper)); border-style: dashed; transition-delay: 0s; }
  .fd-ground { width: 100%; height: 0; margin-top: 2px; border-top: 2px solid var(--ink); }
  .fd-hint { margin: 6px 0 0; font-size: 12px; color: var(--ink-3); opacity: calc(var(--on) * .9); transition: opacity .5s .6s; }
  @media (hover: none) { .fd-hint { display: none; } }
  @media (prefers-reduced-motion: reduce) { .fd-settle, .fd-house, .fd-stone, .fd-hint { transition: none; } }
</style>
