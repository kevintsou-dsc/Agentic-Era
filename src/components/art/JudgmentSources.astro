---
// a14 原刊 p.132–133 的資訊圖「AI vs. Judgment／Judgment 的五大能力來源」的網頁版，版面依紙本：
// 上方 AI 與 Judgment 對照（答案多 vs. 關鍵在於判斷與責任），中間五個能力來源圓圈，下方一句收束。
// 三段主文：① 對照（data-at=1）② 五大能力來源（data-at=2，依序浮現）③ 收束句（data-at=3）。
// 文字照錄原圖（figtext p.128／132／133）。純 SVG＋CSS，class 一律加 js- 前綴。
const sources = [
  { t: '感受與感知', d: '理解人性與需求', icon: 'bulb' },
  { t: '數據基礎', d: '以數據建立洞察', icon: 'db' },
  { t: '趨勢洞察', d: '掌握市場與產業趨勢', icon: 'trend' },
  { t: '經驗判斷', d: '跨產業與專案的實戰經驗', icon: 'star' },
  { t: '組織協作', d: '在有限資源下聚焦執行', icon: 'team' },
];
---
<div class="js" role="img" aria-label="AI vs. Judgment：AI 彙整大量數據與資訊，答案多；Judgment 判斷哪些訊號值得相信、決定哪些機會值得投入，關鍵在於判斷與責任。Judgment 的五大能力來源：感受與感知（理解人性與需求）、數據基礎（以數據建立洞察）、趨勢洞察（掌握市場與產業趨勢）、經驗判斷（跨產業與專案的實戰經驗）、組織協作（在有限資源下聚焦執行）。Judgment 無法被生成，只能透過長期累積與磨練，為決策與結果負責。">
  <section class="js-vs" data-at="1" data-focus="1" aria-hidden="true">
    <div class="js-side js-ai">
      <svg class="js-ic" viewBox="0 0 48 48">
        <rect x="12" y="12" width="24" height="24" rx="3" />
        <rect x="18" y="18" width="12" height="12" rx="1" class="js-ic-in" />
        <path d="M17 12 v-6 M24 12 v-6 M31 12 v-6 M17 36 v6 M24 36 v6 M31 36 v6 M12 17 h-6 M12 24 h-6 M12 31 h-6 M36 17 h6 M36 24 h6 M36 31 h6" />
        <circle cx="17" cy="5" r="1.6" /><circle cx="24" cy="5" r="1.6" /><circle cx="31" cy="5" r="1.6" /><circle cx="17" cy="43" r="1.6" /><circle cx="24" cy="43" r="1.6" /><circle cx="31" cy="43" r="1.6" />
      </svg>
      <div>
        <p class="js-who">AI</p>
        <p class="js-what">彙整大量數據<br />與資訊</p>
      </div>
      <p class="js-bar js-bar-ai">答案多</p>
    </div>
    <span class="js-vs-dot">vs.</span>
    <div class="js-side js-jd">
      <div>
        <p class="js-who">Judgment</p>
        <p class="js-what">判斷哪些訊號值得相信<br />決定哪些機會值得投入</p>
      </div>
      <svg class="js-ic" viewBox="0 0 48 48">
        <path d="M10 40 v-6 q-6 -4 -6 -12 q0 -16 18 -16 q16 0 18 14 l4 7 h-4 v6 q0 4 -4 4 h-5 v3" />
        <path class="js-brain" d="M16 12 q-5 1 -5 6 q-3 2 -1 6 q0 4 4 5 q2 3 6 2 q3 2 6 0 q4 1 5 -3 q4 -2 2 -6 q2 -4 -2 -7 q-1 -4 -6 -4 q-3 -2 -6 0 q-2 -1 -3 1 z" />
        <path class="js-brain-l" d="M20 12 q2 5 -1 9 M26 11 q-2 6 2 10 M14 20 q4 1 6 -2 M24 26 q3 -2 7 -1" />
      </svg>
      <p class="js-bar js-bar-jd">關鍵在於：判斷與責任</p>
    </div>
  </section>

  <section class="js-five" data-at="2" aria-hidden="true">
    <p class="js-h">Judgment 的五大能力來源</p>
    <ol>
      {sources.map((s, i) => (
        <li style={`--d:${i * 140}ms`}>
          <span class="js-circle">
            <span class="js-no">{i + 1}</span>
            <svg class="js-ic" viewBox="0 0 48 48">
              {s.icon === 'bulb' && <g><path d="M24 10 q-10 0 -10 10 q0 6 5 9 v5 h10 v-5 q5 -3 5 -9 q0 -10 -10 -10 z" /><path d="M19 38 h10 M20 42 h8 M24 4 v-0 M12 10 l-3 -3 M36 10 l3 -3 M8 20 h-4 M40 20 h4" class="js-ray" /></g>}
              {s.icon === 'db' && <g><ellipse cx="24" cy="11" rx="12" ry="4" /><path d="M12 11 v26 q12 7 24 0 v-26 M12 20 q12 7 24 0 M12 29 q12 7 24 0" /><circle cx="31" cy="25" r="1.4" class="js-dot" /><circle cx="31" cy="34" r="1.4" class="js-dot" /></g>}
              {s.icon === 'trend' && <g><path d="M8 8 v32 h32" /><path d="M12 34 l8 -10 l6 5 l12 -16" class="js-up" /><path d="M32 13 h6 v6" class="js-up" /></g>}
              {s.icon === 'star' && <g><path d="M20 6 l4 9 l10 1 l-7 7 l2 10 l-9 -5 l-9 5 l2 -10 l-7 -7 l10 -1 z" class="js-star" /><circle cx="36" cy="30" r="4" /><path d="M29 42 q1 -7 7 -7 q6 0 7 7 z" /></g>}
              {s.icon === 'team' && <g><circle cx="24" cy="16" r="5" /><path d="M15 34 q1 -10 9 -10 q8 0 9 10 z" class="js-mid" /><circle cx="13" cy="20" r="4" /><circle cx="35" cy="20" r="4" /><path d="M6 34 q1 -8 7 -8 q4 0 5 3 M42 34 q-1 -8 -7 -8 q-4 0 -5 3" /></g>}
            </svg>
          </span>
          <span class="js-t">{s.t}</span>
          <span class="js-d">{s.d}</span>
        </li>
      ))}
    </ol>
  </section>

  <p class="js-foot" data-at="3" aria-hidden="true">Judgment 無法被生成，只能透過長期累積與磨練，為決策與結果負責。</p>
</div>

<style>
  .js { --red: var(--signal-art); --pink: color-mix(in srgb, var(--accent) 55%, var(--paper)); display: grid; gap: 14px; padding: 14px; border-radius: 18px; background: color-mix(in srgb, var(--accent) 32%, var(--paper)); }
  .js p { margin: 0; }
  .js-ic { width: 44px; height: 44px; flex: none; fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* 上方：AI vs. Judgment */
  .js-vs { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; padding: 16px; border-radius: 10px; background: var(--paper); opacity: calc(.3 + .7 * var(--on)); transition: opacity .5s; }
  .js-vs::after { content: ''; position: absolute; left: 50%; top: 14px; bottom: 14px; width: 1px; background: color-mix(in srgb, var(--red) 45%, transparent); }
  .js-side { display: grid; grid-template-columns: auto 1fr; grid-template-rows: 1fr auto; gap: 10px 12px; align-items: center; }
  .js-jd { grid-template-columns: 1fr auto; }
  .js-who { font-size: 18px; font-weight: 600; letter-spacing: .02em; color: var(--ink-2); text-align: center; }
  .js-jd .js-who { color: var(--red); }
  .js-what { font-size: 15px; font-weight: var(--fw-bold); line-height: 1.5; text-align: center; }
  .js-bar { grid-column: 1 / -1; padding: 4px 10px; text-align: center; font-size: 13px; font-weight: var(--fw-bold); color: #fff; }
  .js-bar-ai { background: #8a8784; }
  .js-bar-jd { background: var(--red); transform-origin: left; transform: scaleX(calc(.6 + .4 * var(--on))); transition: transform .6s .3s; }
  .js-vs-dot { position: absolute; left: 50%; top: 44%; transform: translate(-50%, -50%) scale(calc(.6 + .4 * var(--on))); z-index: 1; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--ink); color: var(--paper); font-weight: var(--fw-bold); font-size: 13px; transition: transform .5s cubic-bezier(.3, 1.6, .5, 1); }
  .js-ai .js-ic-in { fill: color-mix(in srgb, var(--ink) 15%, transparent); }
  .js-brain { fill: var(--pink); }
  .js-brain-l { stroke: var(--red); stroke-width: 1.4; }

  /* 中間：五大能力來源 */
  .js-five { display: grid; gap: 10px; }
  .js-h { text-align: center; font-size: 16px; font-weight: var(--fw-bold); color: var(--ink-2); opacity: calc(.3 + .7 * var(--on)); transition: opacity .5s; }
  .js-five ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .js-five li { display: grid; justify-items: center; gap: 4px; text-align: center; opacity: calc(.15 + .85 * var(--on)); transform: translateY(calc((1 - var(--on)) * 12px)); transition: opacity .5s var(--d), transform .5s var(--d); }
  .js-circle { position: relative; display: grid; place-items: center; width: 100%; max-width: 104px; aspect-ratio: 1; border-radius: 50%; background: var(--pink); padding-top: 18%; }
  .js-no { position: absolute; top: 4%; font-size: clamp(18px, 2vw, 28px); font-weight: var(--fw-bold); color: color-mix(in srgb, var(--red) 45%, var(--pink)); }
  .js-circle .js-ic { width: 46%; height: auto; }
  .js-ray, .js-up { stroke: var(--red); }
  .js-star { fill: color-mix(in srgb, var(--red) 35%, var(--pink)); }
  .js-mid, .js-dot { fill: color-mix(in srgb, var(--red) 35%, var(--pink)); }
  .js-t { margin-top: 4px; font-size: 14px; font-weight: var(--fw-bold); color: var(--red); }
  .js-d { font-size: 11.5px; line-height: 1.4; color: var(--ink-2); }

  /* 下方：收束句 */
  .js-foot { padding: 8px 12px; border-radius: 8px; background: var(--paper); text-align: center; font-size: 13px; font-weight: var(--fw-bold); color: var(--ink-2); opacity: calc(.2 + .8 * var(--on)); box-shadow: inset 0 0 0 calc(var(--on) * 2px) var(--red); transition: opacity .5s, box-shadow .5s; }

  @media (max-width: 560px) {
    .js-vs { grid-template-columns: 1fr; gap: 26px; }
    .js-vs::after { display: none; }
    .js-vs-dot { top: 50%; }
    .js-five ol { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .js *, .js { transition: none !important; }
  }
</style>
