---
// a07 p.54–55「同樣是咖啡，每個人買的理由都不一樣」：一只玻璃咖啡杯，五個購買理由是杯中的分層（奶泡到濃縮）。
// 第 1 段主文：杯裡只是一整杯「咖啡」（商品分類）；第 2 段：咖啡分成五層，由上往下依序倒入，每層標一個情境；
// 第 3 段：右側括號標出「生活情境 → 進入記憶」。理由文字照錄原文。class 一律加 cf- 前綴。
const layers = [
  { t: '清醒', fill: '#f2e4cb', ink: 'var(--ink)' },
  { t: '儀式感', fill: '#dcb88a', ink: 'var(--ink)' },
  { t: '社交', fill: '#b5845a', ink: '#fff' },
  { t: '撐過上班的燃料', fill: '#835535', ink: '#fff' },
  { t: '值得被犒賞一下的理由', fill: '#4a2e1d', ink: '#fff' },
];
// 杯身：上寬下窄的玻璃杯；液面從 top 到 bottom 平均分成五層
const top = 78, bottom = 396, h = (bottom - top) / layers.length;
const glass = 'M68 58 L292 58 L266 404 Q264 414 254 414 L106 414 Q96 414 94 404 Z';
---
<svg class="cf" viewBox="0 0 500 440" role="img" aria-label={'同樣是咖啡，每個人買的理由都不一樣：' + layers.map((l) => l.t).join('、') + '。'}>
  <defs>
    <clipPath id="cf-in"><path d="M74 64 L286 64 L260 400 Q259 408 251 408 L109 408 Q101 408 100 400 Z" /></clipPath>
  </defs>
  <g class="cf-steam" aria-hidden="true">
    <path d="M140 46 q-10 -12 0 -24 q10 -12 0 -24" /><path d="M180 46 q-10 -12 0 -24 q10 -12 0 -24" /><path d="M220 46 q-10 -12 0 -24 q10 -12 0 -24" />
  </g>
  <path class="cf-handle" d="M286 130 C 352 126, 360 250, 274 290" />
  <g clip-path="url(#cf-in)">
    <g class="cf-plain" data-at="2">
      <rect x="60" y={top} width="240" height={bottom - top + 20} />
      <text x="180" y={(top + bottom) / 2 + 8}>咖啡</text>
    </g>
    {layers.map((l, i) => (
      <g class="cf-layer" data-at="2" style={`--d:${i * 160}ms`}>
        <rect x="60" y={top + i * h} width="240" height={h + (i === layers.length - 1 ? 20 : 1)} fill={l.fill} />
        <text x="180" y={top + i * h + h / 2 + 6} fill={l.ink} style={l.t.length > 8 ? 'font-size:14.5px' : undefined}>{l.t}</text>
      </g>
    ))}
  </g>
  <path class="cf-glass" d={glass} />
  <g class="cf-brace" data-at="3" data-focus="3">
    <path d={`M372 ${top} q10 0 10 10 V ${(top + bottom) / 2 - 10} q0 10 10 10 q-10 0 -10 10 V ${bottom - 10} q0 10 -10 10`} />
    <text x="400" y={(top + bottom) / 2 - 8}>生活情境</text>
    <text x="400" y={(top + bottom) / 2 + 14}>→ 進入記憶</text>
  </g>
</svg>

<style>
  .cf { display: block; width: 100%; height: auto; max-height: 62svh; overflow: visible; }
  .cf-glass { fill: none; stroke: var(--ink); stroke-width: 3; stroke-linejoin: round; }
  .cf-handle { fill: none; stroke: var(--ink); stroke-width: 10; stroke-linecap: round; }
  .cf-steam path { fill: none; stroke: color-mix(in srgb, var(--ink) 30%, transparent); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 6 8; animation: cf-steam 3s linear infinite; }
  .cf-steam path:nth-child(2) { animation-delay: -1s; }
  .cf-steam path:nth-child(3) { animation-delay: -2s; }
  @keyframes cf-steam { to { stroke-dashoffset: -28; } }
  /* 第 1 段：一整杯「咖啡」；第 2 段起淡出，換成分層 */
  .cf-plain rect { fill: #9a6a43; }
  .cf-plain { opacity: calc(1 - var(--on)); transition: opacity .6s .3s; }
  .cf-plain text { text-anchor: middle; font: 800 28px var(--font-sans); fill: #fff; letter-spacing: .2em; }
  /* 分層從上方倒入 */
  .cf-layer { opacity: var(--on); transform: translateY(calc((1 - var(--on)) * -40px)); transition: opacity .5s var(--d), transform .7s var(--d) cubic-bezier(.3, 1.3, .5, 1); }
  .cf-layer rect { stroke: rgba(255, 255, 255, .35); stroke-width: 1; }
  .cf-layer text { text-anchor: middle; font: 800 17px var(--font-sans); }
  .cf-brace { opacity: var(--on); transition: opacity .5s; }
  .cf-brace path { fill: none; stroke: var(--accent-ink); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .cf-brace text { font: 800 15px var(--font-sans); fill: var(--accent-ink); }
  @media (prefers-reduced-motion: reduce) { .cf-steam path { animation: none; } .cf-layer, .cf-plain, .cf-brace { transition: none; } }
</style>
