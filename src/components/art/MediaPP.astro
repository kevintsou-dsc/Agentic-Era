---
// a14 原刊 p.134 圖4「Media++ 發展方向與差異化路線圖」的網頁版，版面依原圖：
// 標題列（MEDIA++ PROCESS／ROAD MAP）＋「DENTSU INTELLIGENCE｜三大階段串聯」，三個階段各在一個環裡，
// 兩條交錯的波浪線把三個環串成一條鏈；每階段有圖示、英中名稱、一句定位與兩個模組。
// 第 k 段主文點亮第 k 個階段（data-at／data-focus）。文字照錄 figtext。class 一律加 mp- 前綴。
const stages = [
  { en: 'GROWTH STRATEGY', zh: '成長策略', tag: 'The business growth opportunity we can deliver', icon: 'compass',
    mods: [{ k: 'BUSINESS', en: 'Predictive growth analytics', zh: '預測性成長分析' }, { k: 'AUDIENCES', en: "'now & next' audiences", zh: '現在與未來的受眾' }] },
  { en: 'EXPERIENCE TRANSFORMATION', zh: '體驗轉型', tag: 'The innovative consumer experience that stands apart', icon: 'star',
    mods: [{ k: 'INSIGHTS', en: 'Brand, Culture, Audience, Signals', zh: '品牌、文化、受眾、訊號' }, { k: 'EXPERIENCE', en: 'Ecosystem plus experiences', zh: '生態系加乘體驗' }] },
  { en: 'PERFORMANCE AGILITY', zh: '成效敏捷', tag: 'The outcomes that marketing delivers', icon: 'knight',
    mods: [{ k: 'ACTIVATION', en: 'Ecosystem planning & experimentation', zh: '生態系規劃與實驗' }, { k: 'OPTIMIZATION', en: 'Cross ecosystem outcomes & optimization', zh: '跨生態系成果與優化' }] },
];
// 兩條相位相反的波浪：每個階段一個波峰到波谷，交錯成三個連環
const wave = (sign: number) => {
  let d = `M0 ${50 - sign * 46}`;
  for (let i = 0; i < 3; i++) {
    const x = i * 100;
    d += ` C ${x + 30} ${50 - sign * 46}, ${x + 30} ${50 + sign * 46}, ${x + 50} ${50 + sign * 46} S ${x + 70} ${50 - sign * 46}, ${x + 100} ${50 - sign * 46}`;
  }
  return d;
};
---
<div class="mp" role="img" aria-label={'Media++ 發展方向與差異化路線圖，DENTSU INTELLIGENCE 三大階段串聯：' + stages.map((s) => `${s.zh}（${s.mods.map((m) => `${m.k} ${m.zh}`).join('、')}）`).join('；')}>
  <div class="mp-head" aria-hidden="true">
    <span class="mp-tag">MEDIA++ PROCESS</span>
    <span class="mp-road">IS OUR DEVELOPMENT DIRECTION &amp; DIFFERENTIATION ROAD MAP</span>
  </div>
  <p class="mp-bar" aria-hidden="true">DENTSU INTELLIGENCE ｜三大階段串聯</p>
  <div class="mp-chain" aria-hidden="true">
    <svg class="mp-loops" viewBox="0 0 300 100" preserveAspectRatio="none">
      <path d={wave(1)} /><path d={wave(-1)} />
    </svg>
    {stages.map((s, i) => (
      <section class="mp-stage" data-at={i + 1} data-focus={i + 1}>
        <svg class="mp-ic" viewBox="0 0 40 40">
          {s.icon === 'compass' && <g><circle cx="20" cy="22" r="14" /><circle cx="20" cy="22" r="10" /><path d="M24 17 l-3 7 l-5 3 l3 -7 z" class="mp-fill" /><path d="M17 6 h6 v2 h-6 z" /></g>}
          {s.icon === 'star' && <g><path d="M20 6 l4 9 l10 1 l-7 7 l2 10 l-9 -5 l-9 5 l2 -10 l-7 -7 l10 -1 z" /><path d="M6 6 l3 3 M34 6 l-3 3 M20 1 v3" /></g>}
          {s.icon === 'knight' && <g><path d="M12 34 h18 M14 34 q0 -6 4 -10 q-6 0 -6 -6 q2 -9 12 -12 q8 3 7 14 q-1 7 -3 14" /><circle cx="20" cy="14" r="1.2" class="mp-fill" /></g>}
        </svg>
        <p class="mp-en">{s.en}<b>{s.zh}</b></p>
        <p class="mp-tagline">{s.tag}</p>
        {s.mods.map((m) => (
          <div class="mp-mod">
            <p class="mp-k">{m.k}</p>
            <p class="mp-men">{m.en}</p>
            <p class="mp-mzh">{m.zh}</p>
          </div>
        ))}
      </section>
    ))}
  </div>
</div>

<style>
  .mp { --red: var(--signal-art); display: grid; gap: 10px; padding: 14px 0 18px; border-radius: 14px; background: color-mix(in srgb, var(--ink) 7%, var(--paper)); overflow: hidden; }
  .mp p { margin: 0; }
  .mp-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .mp-tag { padding: 8px 18px; background: var(--red); color: #fff; font-size: 13px; font-weight: var(--fw-bold); letter-spacing: .04em; }
  .mp-road { flex: 1 1 14rem; font-size: 13px; font-weight: 600; color: var(--ink-2); line-height: 1.4; padding-right: 14px; }
  .mp-bar { margin: 0 0 0 0 !important; padding: 4px 14px; background: var(--paper); text-align: center; font-size: 14px; font-weight: var(--fw-bold); letter-spacing: .02em; }
  .mp-chain { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 0 6px; }
  .mp-loops { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .mp-loops path { fill: none; stroke: color-mix(in srgb, var(--red) 35%, var(--paper)); stroke-width: 2.5; vector-effect: non-scaling-stroke; }
  .mp-stage { position: relative; display: grid; justify-items: center; align-content: start; gap: 4px; padding: 20px 10px 28px; text-align: center;
    opacity: calc(.3 + .7 * var(--on)); transform: translateY(calc((1 - var(--on)) * 10px)); transition: opacity .5s, transform .5s; }
  .mp-stage::before { content: ''; position: absolute; inset: 8% 6%; border-radius: 50%; background: color-mix(in srgb, var(--red) calc(var(--focus) * 10%), transparent); transition: background .4s; z-index: -1; }
  .mp-ic { width: 38px; height: 38px; fill: none; stroke: var(--ink); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .mp-fill { fill: var(--ink); }
  .mp-en { font-size: 12px; font-weight: var(--fw-bold); letter-spacing: .03em; color: var(--ink-2); line-height: 1.35; }
  .mp-en b { display: block; font-size: 15px; color: var(--ink); }
  .mp-tagline { font-size: 11px; color: var(--ink-3); line-height: 1.4; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .mp-mod { display: grid; gap: 1px; margin-top: 6px; }
  .mp-k { font-size: 12px; font-weight: var(--fw-bold); letter-spacing: .06em; color: var(--red); }
  .mp-men { font-size: 11px; color: var(--ink-2); line-height: 1.35; }
  .mp-mzh { font-size: 12.5px; font-weight: var(--fw-bold); color: var(--ink); }
  @media (max-width: 560px) {
    .mp-chain { grid-template-columns: 1fr; }
    .mp-loops { display: none; }
    .mp-stage { border-bottom: 2px dashed color-mix(in srgb, var(--red) 35%, var(--paper)); }
    .mp-stage::before { inset: 4% 10%; }
  }
  @media (prefers-reduced-motion: reduce) { .mp-stage { transition: none; } }
</style>
