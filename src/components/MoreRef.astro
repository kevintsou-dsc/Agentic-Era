---
// 細節按鈕「＋ 看更多」：hover 預覽一句話，點擊開啟細節卡（原文詳細段落、案例圖片、影片與網站連結）。
// overlay：圖表元素（長條、節點、層級、清單項）用的版本。按鈕透明覆蓋整個元素，只在角落放一個小圓點，
// 不佔版面；hover 直接預覽細節內容，點擊開啟細節卡。父元素需要 position: relative。
// 只有一個外站連結、沒有其他內容時，不開空的細節卡，直接做成外站連結（一步到位）。
// 細節卡內容放在 <template>，由 scripts/more.ts 放進 <dialog id="more">。
import type { More } from '../lib/story';
import MoreBody from './MoreBody.astro';

interface Props { m?: More; overlay?: boolean; class?: string }
const { m, overlay = false, class: cls } = Astro.props;
const clip = (t: string, n: number) => (t.length > n ? t.slice(0, n) + '…' : t);
const body = m ? (m.text ?? m.quote?.text ?? m.image?.caption ?? '') : '';
// 細節卡要有實質內容（說明、原文或圖片）；只有連結時直接外連
const direct = !!m && !m.text && !m.quote && !m.image && m.links?.length === 1 ? m.links[0] : null;
const preview = !m ? '' : overlay ? `${m.title}${body ? `：${clip(body, 110)}` : ''}（點一下看完整細節）` : (m.text ?? m.image?.caption ?? m.title);
---
{m && direct && (
  <a class:list={['more-ref', 'more-link', { overlay }, cls]} href={direct.url} target="_blank" rel="noopener noreferrer" data-tip={overlay ? `${m.title}（另開${direct.label}）` : undefined} aria-label={overlay ? `${m.title}：${direct.label}（另開新視窗）` : undefined}>
    {overlay ? <span class="more-dot" aria-hidden="true">↗</span> : `${m.title} ↗`}
  </a>
)}
{m && !direct && (
  <button type="button" class:list={['more-ref', { overlay }, cls]} data-more data-tip={preview} aria-haspopup="dialog" aria-label={overlay ? `細節：${m.title}` : undefined}>
    {overlay ? <span class="more-dot" aria-hidden="true">＋</span> : `＋ ${m.title}`}
    <template>
      <h3 class="more-title">{m.title}</h3>
      <MoreBody m={m} />
    </template>
  </button>
)}
