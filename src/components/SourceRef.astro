---
// 出處按鈕「原文 p.xx」：點擊後在原文視窗中開啟整篇文章，捲到引用的段落並高亮。
// 以一段主文或一整張圖表為單位使用，不放在圖表的單一數據上。
import type { Src } from '../lib/story';
import { locate } from '../lib/locate';
import { article, cite } from '../lib/articles';

interface Props { src: Src[]; label?: string }
const { src, label } = Astro.props;
const locs = src.map(locate);
const slug = locs[0]?.slug;
// 同一篇的引文一起高亮；跨篇引用時只開第一篇（目前故事都只引自己那篇）
const segs = locs.filter((l) => l.slug === slug).flatMap((l) => l.segs);
const pages = [...new Set(src.map((s) => s.page))].sort((a, b) => a - b);
const text = label ?? `原文 p.${pages.join('、')}`;
const a = src.length ? article(src[0].article) : undefined;
---
{a && (
  <a class="src-ref" href={`/a/${slug}/full/#p${pages[0]}`} data-reader={JSON.stringify({ slug, page: pages[0], segs })}
     aria-label={`開啟原文：${cite(a)} 紙本 p.${pages.join('、')}`}>{text}</a>
)}
