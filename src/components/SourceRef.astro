---
// 主文後的出處按鈕「紙本 p.xx」；點擊開啟書頁視窗（Base.astro 裡的 <dialog id="book">），
// 內容放在 <template> 裡由 scripts/book.ts 複製進去。label 可覆寫按鈕文字（圖表細節用）。
import type { Src } from '../lib/story';
import { contextOf } from '../lib/context';
import { article, CHAPTERS, authorNames } from '../lib/articles';

interface Props { src: Src[]; label?: string; detail?: string; class?: string }
const { src, label, detail, class: cls } = Astro.props;
const pages = [...new Set(src.map((s) => s.page))];
const text = label ?? `紙本 p.${pages.join('、')}`;
const a = src.length ? article(src[0].article) : undefined;
---
<button type="button" class:list={['src-ref', cls]} data-book aria-haspopup="dialog">
  <span class="src-label">{text}</span>
  <template>
    <div class="book-head">
      {a && <><span class="chip">{CHAPTERS[a.chapter].name}</span><span>{authorNames(a)}〈{a.title}〉</span></>}
    </div>
    {detail && <p class="book-detail">{detail}<span class="curated">　整理：策展者</span></p>}
    {src.map((s) => {
      const c = contextOf(s);
      return (
        <section class="book-page">
          <p class="book-text">{c.before}<mark>{c.match}</mark>{c.after}</p>
          <p class="book-foot">
            <span class="book-pg">p.{c.page}</span>
            <a href={`/a/${article(s.article).slug}/full/#p${c.page}`}>讀這一頁的原文 →</a>
          </p>
        </section>
      );
    })}
  </template>
</button>
