---
// 首頁全書地圖「替這張臉上色」（docs/design-review/home-brainstorm.md，提案 D）。
// 開場的兩張臉留在左邊（手機在上方）當地圖：鉛筆人臉＝People 9 篇，像素 AI 臉＝A.I 6 篇，
// 兩張臉之間五道碎片流＝Model 5 篇，兩隻眼睛＝序章 2 篇。
// 捲動為主：右邊清單捲到哪一篇（或哪一條主線），臉上那一塊就亮起、鏡頭推近；讀過的篇章永久上色。
// 清單是一般連結，沒有 JS 也能用；畫面由 scripts/facemap.ts 繪製，減少動態時不移動。
import { ARTICLES, CHAPTERS, CHAPTER_ORDER, THREADS } from '../../lib/articles';
import { THREAD_INTRO, THREAD_LINES } from '../../data/home';
import { rich } from '../../lib/rich';
import { STORIES } from '../../data/stories';
import { storyMinutes } from '../../lib/stats';

const WHERE = { intro: '兩隻眼睛', people: '鉛筆的臉', model: '兩張臉之間的碎片流', ai: '像素的臉' } as const;
const SCENARIOS = [
  { label: '社群與口碑提案', slug: 'algorithm-or-people', title: '討好演算法，還是打動人？' },
  { label: '媒體預算與注意力', slug: 'buy-attention', title: '別買曝光了，開始買注意力吧' },
  { label: 'SEO／GEO 與轉換', slug: 'geo', title: 'AI 搜尋時代的成長路徑' },
  { label: '組織與 AI 導入', slug: 'cultural-undercurrents', title: 'AI 時代的行銷轉型，為何不只是工具升級？' },
] as const;
const data = ARTICLES.map((a, i) => ({ i, slug: a.slug, ch: a.chapter, t: a.title, th: a.threads }));
const no = (i: number) => String(i + 1).padStart(2, '0');
const firstOf = (key: string) => ARTICLES.find((a) => a.threads.includes(key as never) && STORIES[a.id]);
---
<section class="fm" id="chapters" data-fm data-fm-data={JSON.stringify(data)} aria-labelledby="fm-h">
  <div class="fm-stage" data-fm-stage aria-hidden="true">
    <canvas data-fm-canvas></canvas>
    <div class="fm-hud"><span class="eyebrow">人機智慧臉譜</span><span class="n" data-fm-n></span><span class="c" data-fm-c></span></div>
    <div class="fm-legend"><span><i style="--k:#c08a3e"></i>序章｜兩隻眼睛</span><span><i style="--k:#6fa83a"></i>人｜鉛筆的臉</span><span><i style="--k:#d0544c"></i>模型｜之間的碎片流</span><span><i style="--k:#2a9db5"></i>行動｜像素的臉</span></div>
    <div class="fm-toast" data-fm-toast></div>
  </div>
  <div class="fm-list" data-fm-list>
    <header class="fm-head">
      <p class="eyebrow">全書地圖｜22 篇觀點</p>
      <h2 id="fm-h" class="h2 serif">22 篇觀點，畫在兩張臉上</h2>
      <p>全書分四章：序章定調，<b>People</b> 談人，<b>Model</b> 談模型，<b>A.I</b>（Actionable Insights）談行動。人這章在鉛筆的臉上，行動這章在像素的臉上，模型這章是兩張臉之間流動的碎片。每讀完一篇，就為這張臉譜點亮一塊色彩。</p>
      <div class="fm-picks" aria-label="依行銷情境選讀">
        <span class="fm-jump-l">從手邊課題開始</span>
        {SCENARIOS.map((sc) => <a class="fm-pick" href={`/story/${sc.slug}/`} title={`推薦閱讀：〈${sc.title}〉`}>{sc.label} →</a>)}
      </div>
    </header>
    <p class="fm-threads-h"><b>四條主線</b>{THREAD_INTRO}</p>
    <div class="fm-threads">
      {THREADS.map((t, i) => {
        const first = firstOf(t.key);
        const count = ARTICLES.filter((a) => a.threads.includes(t.key as never) && STORIES[a.id]).length;
        return (
          <a class="fm-thread" data-fm-step data-thread={t.key} href={first ? `/story/${first.slug}/` : '#chapters'} title={first ? `從〈${first.title}〉開始讀這條線` : undefined}>
            <span class="k">主線 {i + 1}</span><span class="n">{t.name}</span><span class="go" aria-hidden="true">→</span>
            <span class="d"><span><em>照著讀 {count} 篇，你會看懂</em><span set:html={rich(THREAD_LINES[t.key])} /></span></span>
          </a>
        );
      })}
    </div>
    {CHAPTER_ORDER.map((ch) => {
      const list = ARTICLES.filter((a) => a.chapter === ch);
      return (
        <div class="fm-group" role="group" aria-labelledby={`fm-${ch}`}>
          <h3 class="fm-ch" id={`fm-${ch}`}><span class="serif">{CHAPTERS[ch].zh}</span><span class="en">{CHAPTERS[ch].name}</span><em>{WHERE[ch]}｜{list.length} 篇</em></h3>
          <ul role="list">
            {list.map((a) => {
              const i = ARTICLES.indexOf(a), s = STORIES[a.id];
              return (
                <li>
                  <a class={`fm-row ch-${ch}`} data-fm-step data-i={i} data-slug={a.slug} href={s ? `/story/${a.slug}/` : `/story/${a.slug}/original/`}>
                    <span class="no">{no(i)}</span>
                    <span class="t">{a.title}{a.subtitle && <span class="sub">{a.subtitle}</span>}</span>
                    <span class="s">{a.authors.map((x) => x.name).join('、')}<span class="r">已點亮</span></span>
                    {s && <span class="o">{s.oneLiner}</span>}
                    <span class="m">{s ? `精華 ${storyMinutes(s)} 分鐘` : `原文約 ${a.minutes} 分鐘`}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })}
    <div class="fm-share" data-fm-share hidden>
      <p class="eyebrow">人機智慧臉譜</p>
      <p>已點亮 <b data-fm-share-n></b>。把它存成一張圖，分享給也在想這些問題的人。</p>
      <div class="fm-share-actions">
        <button type="button" class="btn" data-fm-share-go>分享人機智慧臉譜</button>
        <button type="button" class="btn ghost" data-fm-share-dl>下載圖片</button>
      </div>
      <p class="msg" data-fm-share-msg aria-live="polite"></p>
    </div>
    <p class="source">標題、作者與職稱以文章內頁為準；每篇精華的每一句都附紙本頁碼，可逐句對照原文。</p>
  </div>
</section>
<script>
  import { initFaceMap } from '../../scripts/facemap';
  initFaceMap();
</script>
<style>
  .fm { --top: 58px; position: relative; display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); max-width: 88rem; margin: 0 auto; }
  .fm-stage { position: sticky; top: var(--top); height: calc(100svh - var(--top)); min-height: 420px; }
  .fm-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; }
  .fm-hud { position: absolute; left: var(--gutter); top: 14px; display: grid; gap: 2px; pointer-events: none; padding: 6px 12px; border-radius: 10px; background: color-mix(in srgb, var(--paper) 88%, transparent); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .fm-hud .n { font-family: var(--font-serif); font-weight: 900; font-size: clamp(26px, 2.6vw, 38px); line-height: 1.1; }
  .fm-hud .n :global(small) { font-size: .5em; color: var(--ink-3); margin-left: 4px; }
  .fm-hud .c { font-size: var(--fs-meta); color: var(--ink-2); min-height: 1.6em; }
  .fm-legend { position: absolute; left: 12px; right: 12px; bottom: 12px; width: fit-content; max-width: calc(100% - 24px); margin: 0 auto; padding: 4px 12px; border-radius: var(--r-pill); background: color-mix(in srgb, var(--paper) 88%, transparent); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 18px; font-size: var(--fs-caption); color: var(--ink-2); pointer-events: none; }
  .fm-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 5px; vertical-align: -1px; background: var(--k); }
  .fm-toast { position: absolute; left: 50%; bottom: 52px; translate: -50% 12px; max-width: calc(100% - 24px); padding: 10px 16px; border-radius: var(--r-pill); background: var(--ink); color: var(--paper); font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: 0; transition: opacity .35s, translate .35s var(--ease-out); pointer-events: none; }
  .fm-toast:global(.on) { opacity: 1; translate: -50% 0; }

  .fm-list { padding: 22svh var(--gutter) 30svh 8px; }
  .fm-head { margin-bottom: 12svh; }
  .fm-head p:not(.eyebrow) { color: var(--ink-2); }
  .fm-jump, .fm-picks { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 16px; }
  .fm-jump-l { font-size: var(--fs-caption); color: var(--ink-3); margin-right: 4px; }
  .fm-pill { display: inline-flex; align-items: baseline; gap: 5px; padding: 5px 12px; border-radius: var(--r-pill); border: 1px solid var(--line); background: var(--paper); font-size: var(--fs-meta); font-weight: var(--fw-bold); text-decoration: none; color: var(--ink); transition: border-color .2s, background-color .2s; }
  .fm-pill span { font-family: var(--font-mono); font-size: var(--fs-micro); font-weight: var(--fw-regular); color: var(--ink-3); }
  .fm-pill:hover { border-color: var(--accent-ink); background: color-mix(in srgb, var(--accent) 45%, var(--paper)); }
  .fm-pick { display: inline-flex; align-items: center; padding: 5px 12px; border-radius: var(--r-pill); border: 1px solid var(--line); background: var(--paper-2); font-size: var(--fs-caption); font-weight: var(--fw-medium); color: var(--ink-2); text-decoration: none; transition: border-color .2s, color .2s, background-color .2s; }
  .fm-pick:hover { border-color: var(--ink); color: var(--ink); background: var(--paper); }
  .fm-share-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  /* 四條主線：一行一條的文字連結（捲過時臉譜仍會亮出該主線的篇章） */
  .fm-threads-h { margin: 0 0 12px; font-size: var(--fs-small); line-height: 1.7; color: var(--ink-2); }
  .fm-threads-h b { display: block; margin-bottom: 2px; font-size: var(--fs-meta); letter-spacing: .08em; color: var(--ink); }
  .fm-threads { display: grid; margin-bottom: 10svh; border-top: 1px solid var(--line); }
  .fm-thread .d em { display: block; font-style: normal; font-size: var(--fs-caption); font-weight: var(--fw-bold); letter-spacing: .04em; color: var(--accent-ink); margin-bottom: 2px; }
  .fm-thread { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 12px; padding: 14px 4px; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; opacity: .8; transition: opacity .35s; }
  .fm-thread .k { flex: none; font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: .1em; color: var(--ink-3); }
  .fm-thread .n { font-weight: var(--fw-bold); }
  .fm-thread .go { margin-left: auto; color: var(--ink-3); transition: translate .2s; }
  .fm-thread:global(.on), .fm-thread:hover, .fm-thread:focus-visible { opacity: 1; }
  .fm-thread:hover .go { translate: 4px 0; color: var(--ink); }
  /* 說明：滑過、鍵盤聚焦或捲到該主線時展開（手機沒有滑過，捲到就展開） */
  .fm-thread .d { flex-basis: 100%; display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows .35s var(--ease-out), opacity .3s, margin .35s; }
  .fm-thread .d > span { overflow: hidden; min-height: 0; padding-left: calc(3.6em); font-size: var(--fs-small); line-height: 1.65; color: var(--ink-2); }
  .fm-thread:is(:hover, :focus-visible, :global(.on)) .d { grid-template-rows: 1fr; opacity: 1; margin-top: 6px; }
  .btn.small { padding: 8px 14px; font-size: 14px; }
  .fm-group ul { list-style: none; margin: 0; padding: 0; }
  .fm-group + .fm-group { margin-top: 9svh; }
  .fm-ch { display: flex; align-items: baseline; gap: 10px; margin: 0 0 8px; font-size: inherit; scroll-margin-top: 84px; }
  .fm-ch .serif { font-size: var(--fs-h2); font-weight: 900; line-height: 1; }
  .fm-ch .en { font-family: var(--font-mono); font-size: var(--fs-caption); letter-spacing: .16em; text-transform: uppercase; color: var(--ink-3); }
  .fm-ch em { margin-left: auto; font-style: normal; font-size: var(--fs-caption); color: var(--ink-3); }
  .fm-row { position: relative; display: grid; grid-template-columns: 3.2rem 1fr; gap: 0 12px; padding: 16px 0 18px 14px; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; opacity: .78; transition: opacity .35s; }
  .fm-row::before { content: ""; position: absolute; left: 0; top: 16px; bottom: 18px; width: 4px; border-radius: 2px; background: var(--accent-ink); scale: 1 0; transform-origin: top; transition: scale .4s var(--ease-out); }
  .fm-row:global(.on), .fm-row:hover, .fm-row:focus-visible { opacity: 1; }
  .fm-row:global(.on)::before { scale: 1 1; }
  .fm-row > :not(.no) { grid-column: 2; }
  .fm-row .no { grid-row: span 5; font-family: var(--font-serif); font-weight: 900; font-size: 32px; line-height: 1; color: var(--ink-3); transition: color .35s; }
  .fm-row:global(.on) .no, .fm-row:global(.read) .no { color: var(--accent-ink); }
  .fm-row .t { font-family: var(--font-serif); font-weight: 900; font-size: clamp(19px, 1.1vw + 8px, 23px); line-height: 1.35; }
  .fm-row .sub { display: block; font-family: var(--font-sans); font-weight: var(--fw-regular); font-size: var(--fs-small); color: var(--ink-2); margin-top: 2px; }
  .fm-row .s { font-size: var(--fs-meta); color: var(--ink-3); margin-top: 4px; }
  .fm-row .r { display: none; margin-left: 8px; padding: 0 7px; border-radius: var(--r-pill); background: var(--accent-ink); color: var(--paper); font-size: 11px; font-weight: var(--fw-bold); }
  .fm-row:global(.read) .r { display: inline-block; }
  .fm-row .o { margin-top: 6px; font-size: var(--fs-small); line-height: 1.65; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .fm-row .m { margin-top: 6px; font-size: var(--fs-caption); font-weight: var(--fw-bold); color: var(--accent-ink); }
  .fm-share { margin-top: 9svh; padding: 20px 22px; border-radius: var(--r-l); border: 1px solid var(--ink); background: var(--paper); }
  .fm-share[hidden] { display: none; }
  .fm-share p { margin: 0 0 12px; }
  .fm-share .msg { margin: 10px 0 0; min-height: 1.5em; font-size: var(--fs-meta); color: var(--ink-2); }
  .source { margin-top: 6svh; font-size: var(--fs-meta); color: var(--ink-3); }

  @media (max-width: 860px) {
    .fm { grid-template-columns: 1fr; }
    .fm-stage { z-index: 2; height: clamp(132px, 18svh, 160px); min-height: 0; background: var(--paper); border-bottom: 1px solid var(--line); box-shadow: 0 8px 20px -16px rgba(31, 29, 26, .22); }
    /* 清單讀完後，分享與附註蓋過黏在上方的臉譜（等同放開），不再佔住畫面 */
    .fm-share, .source { position: relative; z-index: 3; background: var(--paper); }
    .fm-share + .source, .source { padding-block: 8px; }
    .fm-hud { top: 6px; left: 10px; padding: 3px 8px; border-radius: 8px; }
    .fm-hud .n { font-size: 19px; }
    .fm-legend { bottom: 4px; gap: 2px 10px; font-size: 10px; padding: 2px 8px; border-radius: 6px; left: 8px; right: 8px; max-width: calc(100% - 16px); }
    .fm-legend i { width: 8px; height: 8px; margin-right: 3px; }
    .fm-hud .c:not(:empty) { justify-self: start; }
    .fm-toast { bottom: 26px; font-size: 12px; }
    .fm-list { padding: 4svh var(--gutter) 6svh; }
    .fm-head { margin-bottom: 8svh; }
    .fm-ch { scroll-margin-top: calc(20svh + 72px); }
    .fm-threads { margin-bottom: 8svh; }
    .fm-row { grid-template-columns: 2.6rem 1fr; }
    .fm-row .no { font-size: 26px; }
  }
  /* 沒有 JS 或減少動態以外的情況都由腳本畫圖；沒有 JS 時不留空白畫布，清單全亮 */
  @media (scripting: none) {
    .fm { grid-template-columns: 1fr; }
    .fm-stage { display: none; }
    .fm-row, .fm-thread { opacity: 1; }
  }
</style>
