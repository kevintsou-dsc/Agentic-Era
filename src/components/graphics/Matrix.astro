---
// 2×2 矩陣：第 k 步聚焦第 k 格（左上、右上、左下、右下）；讀者也可以點任一格展開做法
import type { Graphic } from '../../lib/story';
type G = Extract<Graphic, { type: 'matrix' }>;
interface Props { g: G }
const { g } = Astro.props;
---
<div class="stage matrix" data-matrix>
  <p class="title">{g.title}</p>
  <div class="frame">
    <span class="y-axis"><b>{g.y.label}</b><span>{g.y.high} ↑　{g.y.low} ↓</span></span>
    <div class="grid">
      {g.quads.map((q, i) => (
        <button type="button" class="q" data-focus={i + 1} aria-expanded="false">
          <span class="case">{q.case}</span>
          <span class="name">{q.name}</span>
          <ul>{q.items.map((it) => <li>{it}</li>)}</ul>
        </button>
      ))}
    </div>
    <span class="x-axis"><b>{g.x.label}</b>　← {g.x.left}　{g.x.right} →</span>
  </div>
  <p class="hint">點任一格看做法</p>
  <p class="source">{g.source}</p>
</div>
<script>
  document.querySelectorAll('[data-matrix]').forEach((m) => {
    const buttons = m.querySelectorAll<HTMLButtonElement>('.q');
    buttons.forEach((btn) => btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      buttons.forEach((b) => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(!open));
    }));
  });
</script>
<style>
  .matrix { width: 100%; display: grid; gap: 10px; }
  .title { margin: 0; font-weight: 700; font-size: clamp(16px, 1.2vw + 10px, 20px); }
  .frame { display: grid; grid-template-columns: auto 1fr; gap: 8px; }
  .y-axis { writing-mode: vertical-rl; transform: rotate(180deg); font-size: 12px; color: var(--ink-2); display: flex; gap: 8px; justify-content: center; }
  .x-axis { grid-column: 2; font-size: 12px; color: var(--ink-2); text-align: center; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  /* --lit：捲動聚焦（--focus）或讀者點開（--open）任一成立就高亮並展開 */
  .q { --open: 0; --lit: max(var(--focus), var(--open)); all: unset; box-sizing: border-box; cursor: pointer; display: grid; align-content: start; gap: 4px; min-height: 92px; padding: 12px 14px; border-radius: 12px; border: 2px solid color-mix(in srgb, var(--accent-ink) calc(var(--lit) * 100%), var(--line)); background: color-mix(in srgb, var(--accent) calc(var(--lit) * 100%), var(--paper)); transition: background .4s, border-color .4s; }
  .q[aria-expanded="true"] { --open: 1; }
  .q:focus-visible { outline: 3px solid var(--accent-ink); outline-offset: 2px; }
  .case { font-size: 12px; color: var(--ink-2); }
  .name { font-weight: 800; font-size: clamp(17px, 1.4vw + 10px, 22px); }
  .q ul { margin: 0; padding-left: 1.1em; font-size: 13px; line-height: 1.5; max-height: calc(var(--lit) * 10em); overflow: hidden; transition: max-height .4s; }
  .hint { margin: 0; font-size: 12px; color: var(--ink-3); }
  @media (max-width: 560px) {
    .frame { grid-template-columns: 1fr; }
    .y-axis { writing-mode: horizontal-tb; transform: none; justify-content: flex-start; flex-wrap: wrap; }
    .x-axis { grid-column: 1; }
    .q { min-height: 76px; padding: 10px 12px; }
  }
</style>
