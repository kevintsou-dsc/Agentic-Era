---
// d3 圖表的容器：資料以 data-d3 傳給 src/scripts/d3charts.ts 繪製。
// 內含純文字版資料（.d3-fallback）：沒有 JavaScript 時顯示，也給螢幕閱讀器讀。
import type { Graphic } from '../../lib/story';
type G = Extract<Graphic, { type: 'd3' }>;
interface Props { g: G }
const { g } = Astro.props;
const c = g.chart;
const summary =
  c.kind === 'flowloop' ? c.nodes.map((n) => n.label + (n.desc ? `：${n.desc}` : '')) :
  c.kind === 'groups' ? c.groups.map((x) => `${x.name}：${x.items.map((i) => `${i.label} ${i.value}%`).join('、')}`) :
  c.kind === 'logrange' ? c.rows.map((r) => `${r.label}：${r.min === r.max ? `${r.min}×` : `${r.min}–${r.max}×${r.open ? ' 以上' : ''}`}`) :
  c.kind === 'esov' ? [
    `${c.som.label}（${c.som.sub}）${c.som.value}%，${c.sov.label}（${c.sov.sub}）${c.sov.value}%，${c.result.label} = ${c.sov.value} − ${c.som.value} = +${c.sov.value - c.som.value}`,
    `${c.fieldsTitle}：${c.fields.map((f) => f.label).join('、')}`,
    `${c.checksTitle}${c.checks.map((q) => q.label).join('')}`,
  ] :
  c.kind === 'allocate' ? [
    `${c.layersTitle}：${c.layers.map((l) => l.label).join('、')}`,
    `${c.splitTitle}：${c.main.label}；${c.roles.map((r) => r.label).join('、')}`,
    `${c.outcomeTitle}：${c.once.label}，或${c.asset.label}`,
  ] :
  c.kind === 'spectrum' ? [...c.levels.map((l) => `${l.label}：${l.desc}`), ...c.markers.map((m) => `${m.label}：約在「${c.levels[Math.min(c.levels.length - 1, Math.round(m.pos))].label}」層`)] :
  c.kind === 'iceberg' ? [`${c.aboveTitle}：${c.above.map((x) => x.label).join('、')}`, `${c.belowTitle}：${c.below.map((x) => x.label).join('、')}`] :
  c.kind === 'venn' ? [`${c.left.label}：${c.left.items.join('、')}`, `${c.right.label}：${c.right.items.join('、')}`, `${c.both.label}：${c.both.desc}`] :
  c.kind === 'balance' ? c.states.map((s) => `${s.label}（${s.years}）：${s.desc}`) :
  c.kind === 'rings' ? [...c.rings.map((r) => `${r.label}：${r.desc}`), ...(c.pulls ? [`會被帶走的：${c.pulls.join('、')}`] : [])] :
  c.rows.map((r) => `${r.model}（${r.era}）：${r.steps.map((s) => s.zh).join(' → ')}`);
---
<div class="stage d3wrap">
  <p class="title">{c.title}</p>
  <div class="d3" data-d3={JSON.stringify(c)} role="figure" aria-label={c.title}>
    <ul class="d3-fallback">{summary.map((s) => <li>{s}</li>)}</ul>
  </div>
  <p class="source">{g.source}</p>
</div>
<script>
  import { initD3 } from '../../scripts/d3charts';
  initD3();
</script>
<style>
  .d3wrap { width: 100%; display: grid; gap: 10px; }
  .title { margin: 0; font-weight: var(--fw-bold); font-size: clamp(17px, 1.4vw + 10px, 22px); }
  .d3 { position: relative; }
  .d3 :global(svg) { width: 100%; height: auto; max-height: 56svh; overflow: visible; }

  /* 可互動元素：游標、hover 放大、鍵盤焦點 */
  .d3 :global(.has-tip) { cursor: pointer; outline: none; }
  .d3 :global(.fl-node.has-tip circle), .d3 :global(.cell.has-tip rect) { transition: fill .5s, stroke .5s, stroke-width .2s; }
  .d3 :global(.fl-node.has-tip:hover circle), .d3 :global(.fl-node.has-tip:focus-visible circle) { stroke-width: 6; }
  .d3 :global(.cell.has-tip:hover rect), .d3 :global(.cell.has-tip:focus-visible rect),
  .d3 :global(.row.has-tip:hover .gr-track), .d3 :global(.lr-row.has-tip:hover .lr-bar) { stroke: var(--ink); stroke-width: 2; }
  .d3 :global(.has-tip:focus-visible) { filter: drop-shadow(0 0 0 var(--accent-ink)) drop-shadow(0 0 3px var(--accent-ink)); }

  /* 說明框 */
  .d3 :global(.d3-tip) {
    position: absolute; z-index: 8; width: min(24rem, 94%); padding: 12px 14px; border-radius: 12px;
    /* 深色毛玻璃：半透明墨色＋背景模糊，1px 淡白框，頂緣一道水平高光模擬受光面 */
    background: color-mix(in srgb, var(--ink) 84%, transparent); color: var(--paper);
    -webkit-backdrop-filter: blur(24px) saturate(1.4); backdrop-filter: blur(24px) saturate(1.4);
    border: 1px solid rgba(255,255,255,.08); box-shadow: 0 14px 30px -14px rgba(0,0,0,.6);
    pointer-events: none; font-size: 14px; line-height: 1.6;
  }
  .d3 :global(.d3-tip::before) { content: ""; position: absolute; top: -1px; left: 12px; right: 12px; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,.3), transparent); }
  .d3 :global(.d3-tip b) { display: block; font-size: 15px; margin-bottom: 4px; }
  .d3 :global(.d3-tip p) { margin: 0 0 6px; }
  .d3 :global(.d3-tip .tip-body) { color: var(--paper-2); }
  .d3 :global(.d3-tip .tip-tag) { display: block; margin-bottom: 2px; font: 600 11px var(--font-mono); letter-spacing: .04em; color: #bdb3a2; }
  .d3 :global(.d3-tip .tip-body + .tip-extra) { margin-top: 8px; padding-top: 8px; border-top: 1px dashed rgba(255,255,255,.28); }
  .d3 :global(.d3-tip .tip-extra) { color: var(--paper-2); }
  .d3 :global(.d3-tip .tip-extra .tip-tag) { color: var(--accent, #f2b84b); }
  .d3 :global(.st-head) { cursor: pointer; }
  .d3 :global(.st-head-hit) { fill: transparent; }
  .d3 :global(.st-head.has-tip:hover .st-head-hit), .d3 :global(.st-head.has-tip:focus-visible .st-head-hit) { fill: rgba(0,0,0,.05); stroke: var(--ink); stroke-width: 1.5; }
  .d3-fallback { margin: 0; padding-left: 1.2em; font-size: 15px; }

  /* flowloop */
  .d3 :global(.fl-arc) { fill: none; stroke: var(--line); stroke-width: 10; stroke-linecap: round; transition: stroke .6s; }
  .d3 :global(.fl-arc.on) { stroke: var(--accent); }
  .d3 :global(.fl-node circle) { fill: var(--paper); stroke: var(--line); stroke-width: 3; transition: fill .5s, stroke .5s; }
  .d3 :global(.fl-node.on circle) { fill: var(--accent); stroke: var(--accent-ink); }
  .d3 :global(.fl-node.cur circle) { stroke-width: 6; }
  .d3 :global(.fl-node text) { fill: var(--ink-3); transition: fill .5s; }
  .d3 :global(.fl-node.on text) { fill: var(--ink); }
  .d3 :global(.fl-label) { font: 800 15px var(--font-sans); }
  .d3 :global(.fl-sub) { font: 600 10px var(--font-mono); letter-spacing: .06em; }
  .d3 :global(.fl-center circle) { fill: var(--accent-ink); opacity: .12; transform-box: fill-box; transform-origin: center; transition: transform 1.2s ease, opacity 1.2s; }
  .d3 :global(.fl-center circle.shrink) { transform: scale(.45); opacity: .06; }
  .d3 :global(.fl-center text) { font: 800 20px var(--font-sans); fill: var(--ink); }
  .d3 :global(.fl-dots circle) { fill: var(--accent-ink); }

  /* groups */
  .d3 :global(.gr-group) { opacity: .25; transition: opacity .5s; }
  .d3 :global(.gr-group.on) { opacity: 1; }
  .d3 :global(.gr-name) { font: 800 15px var(--font-sans); fill: var(--ink); }
  .d3 :global(.gr-label) { font: 500 13px var(--font-sans); fill: var(--ink-2); }
  .d3 :global(.gr-track) { fill: var(--paper-2); }
  .d3 :global(.gr-bar) { fill: var(--ink-3); transition: width 1s var(--ease-out); }
  .d3 :global(.gr-bar.best) { fill: var(--accent-ink); }
  .d3 :global(.gr-val) { font: 700 13px var(--font-mono); fill: var(--ink); transition: x 1s var(--ease-out); }

  /* logrange */
  .d3 :global(.lr-tick line) { stroke: var(--line); stroke-dasharray: 3 4; }
  .d3 :global(.lr-tick text) { font: 600 11px var(--font-mono); fill: var(--ink-3); }
  .d3 :global(.lr-row) { opacity: .3; transition: opacity .5s; }
  .d3 :global(.lr-row.on) { opacity: 1; }
  .d3 :global(.lr-label) { font: 800 16px var(--font-sans); fill: var(--ink); }
  .d3 :global(.lr-sub) { font: 500 11px var(--font-sans); fill: var(--ink-3); }
  .d3 :global(.lr-bar) { transition: width 1s var(--ease-out); }
  .d3 :global(.lr-open) { font: 800 18px var(--font-sans); fill: var(--accent-ink); }

  /* esov */
  .d3 :global(.es-a), .d3 :global(.es-b), .d3 :global(.es-c) { transition: opacity .6s; }
  .d3 :global(.es-a) { opacity: .25; }
  .d3 :global(.es-a.on) { opacity: 1; }
  .d3 :global(.es-b), .d3 :global(.es-c) { opacity: 0; pointer-events: none; }
  .d3 :global(.es-b.on), .d3 :global(.es-c.on) { opacity: 1; pointer-events: auto; }
  .d3 :global(.es-formula) { font: 800 15px var(--font-mono); fill: var(--accent-ink); }
  .d3 :global(.es-label) { font: 800 16px var(--font-sans); fill: var(--ink); }
  .d3 :global(.es-sub) { font: 500 11px var(--font-sans); fill: var(--ink-3); }
  .d3 :global(.es-axis) { stroke: var(--ink); stroke-width: 2; }
  .d3 :global(.es-som) { fill: var(--paper-2); stroke: var(--ink-3); stroke-width: 2; }
  .d3 :global(.es-sov) { fill: var(--accent); stroke: var(--accent-ink); stroke-width: 2; transition: opacity .4s; }
  .d3 :global(.es-sov.dim) { opacity: .28; }
  .d3 :global(.es-excess) { fill: transparent; transition: fill .4s; }
  .d3 :global(.es-excess.lit) { fill: var(--accent-ink); }
  .d3 :global(.es-cutter) { fill: rgba(255, 255, 255, .35); stroke: var(--ink); stroke-width: 2; stroke-dasharray: 6 5; pointer-events: none; }
  .d3 :global(.es-val) { font: 800 18px var(--font-mono); fill: var(--ink); }
  .d3 :global(.es-brace) { transition: opacity .4s; }
  .d3 :global(.es-brace path) { fill: none; stroke: var(--accent-ink); stroke-width: 2.5; }
  .d3 :global(.es-brace text) { font: 800 18px var(--font-sans); fill: var(--accent-ink); }
  .d3 :global(.es-h) { font: 800 15px var(--font-sans); fill: var(--ink); }
  .d3 :global(.es-tile rect) { fill: var(--paper); stroke: var(--ink-3); stroke-width: 2; transition: stroke .2s; }
  .d3 :global(.es-tile.has-tip:hover rect) { stroke: var(--ink); stroke-width: 3; }
  .d3 :global(.es-tile text) { font: 700 12px var(--font-sans); fill: var(--ink); }
  .d3 :global(.es-tile .es-one) { font: 500 10px var(--font-mono); fill: var(--ink-3); }
  .d3 :global(.es-note) { font: 500 12px var(--font-sans); fill: var(--ink-2); }
  .d3 :global(.es-note) { transition: opacity .4s; }
  .d3 :global(.es-beam) { fill: none; stroke: var(--accent-ink); stroke-width: 3; transition: x .35s, opacity .4s; pointer-events: none; }
  .d3 :global(.es-tile.scan rect) { fill: var(--accent); }
  .d3 :global(.es-check rect) { fill: var(--paper); stroke: var(--accent-ink); stroke-width: 2; }
  .d3 :global(.es-check.has-tip:hover rect), .d3 :global(.es-check.has-tip:focus-visible rect) { fill: var(--accent); }
  .d3 :global(.es-check text) { font: 700 13px var(--font-sans); fill: var(--ink); }
  .d3 :global(.es-check .es-check-no) { font: 800 11px var(--font-mono); fill: var(--accent-ink); }

  /* spectrum */
  .d3 :global(.sp-levels) { opacity: .3; transition: opacity .5s; }
  .d3 :global(.sp-levels.on) { opacity: 1; }
  .d3 :global(.sp-level rect) { stroke: var(--accent-ink); stroke-width: 2; }
  .d3 :global(.sp-l0 rect) { fill: color-mix(in srgb, var(--accent) 25%, var(--paper)); }
  .d3 :global(.sp-l1 rect) { fill: color-mix(in srgb, var(--accent) 50%, var(--paper)); }
  .d3 :global(.sp-l2 rect) { fill: color-mix(in srgb, var(--accent) 75%, var(--paper)); }
  .d3 :global(.sp-l3 rect) { fill: var(--accent); }
  .d3 :global(.sp-level.has-tip:hover rect) { stroke: var(--ink); stroke-width: 3; }
  .d3 :global(.sp-lab) { font: 800 15px var(--font-sans); fill: var(--ink); }
  .d3 :global(.sp-desc) { font: 500 11px var(--font-sans); fill: var(--ink-2); }
  .d3 :global(.sp-arrow) { fill: none; stroke: var(--ink-3); stroke-width: 2; }
  .d3 :global(.sp-axis) { font: 600 11px var(--font-sans); fill: var(--ink-3); }
  .d3 :global(.sp-mk) { opacity: 0; transition: transform .7s var(--ease-spring), opacity .4s; }
  .d3 :global(.sp-mk.on) { opacity: 1; }
  .d3 :global(.sp-mk line) { stroke: var(--ink); stroke-width: 2; stroke-dasharray: 3 3; }
  .d3 :global(.sp-mk rect) { fill: var(--ink); }
  .d3 :global(.sp-mk.has-tip:hover rect) { fill: var(--accent-ink); }
  .d3 :global(.sp-mk text) { font: 700 12px var(--font-sans); fill: var(--paper); }

  /* iceberg */
  .d3 :global(.ib-water) { fill: color-mix(in srgb, #5f8fa8 30%, var(--paper)); transition: fill .6s; }
  .d3 :global(.deep .ib-water) { fill: color-mix(in srgb, #2f5d74 45%, var(--paper)); }
  .d3 :global(.ib-wave) { fill: none; stroke: #5f8fa8; stroke-width: 2.5; }
  .d3 :global(.ib-tip) { fill: #fff; stroke: var(--ink-2); stroke-width: 2.5; stroke-linejoin: round; }
  .d3 :global(.ib-base) { fill: rgba(255, 255, 255, .55); stroke: var(--ink-3); stroke-width: 2; stroke-dasharray: 6 5; stroke-linejoin: round; }
  .d3 :global(.ib-zone) { font: 800 13px var(--font-sans); fill: var(--ink-2); }
  .d3 :global(.ib-zone.below) { fill: var(--ink); }
  .d3 :global(.ib-chips) { opacity: .25; transition: opacity .5s; }
  .d3 :global(.ib-chips.on) { opacity: 1; }
  .d3 :global(.ib-chip rect) { fill: var(--paper); stroke: var(--ink-3); stroke-width: 2; transition: fill .3s; }
  .d3 :global(.ib-chips.focus .ib-chip rect) { fill: var(--accent); stroke: var(--accent-ink); }
  .d3 :global(.ib-chip.has-tip:hover rect) { stroke: var(--ink); stroke-width: 3; }
  .d3 :global(.ib-chip text) { font: 700 13px var(--font-sans); fill: var(--ink); }

  /* venn */
  /* 兩個圓同等份量：未強調時一樣淡；當段的圓填滿、加粗外框，另一個圓退到很淡，強調才明顯 */
  .d3 :global(.vn-c) { fill-opacity: .28; stroke-width: 3; transition: fill-opacity .4s, opacity .4s, stroke-width .4s; }
  .d3 :global(.vn-l) { fill: color-mix(in srgb, var(--ink) 26%, var(--paper)); stroke: var(--ink); }
  .d3 :global(.vn-r) { fill: var(--accent); stroke: var(--accent-ink); }
  .d3 :global(.vn-c.focus) { fill-opacity: .8; stroke-width: 5; }
  .d3 :global(.vn-c.dim) { opacity: .22; }
  .d3 :global(.vn-c.has-tip:hover) { fill-opacity: .8; }
  .d3 :global(.vn-both) { fill: var(--accent-ink); opacity: 0; transition: opacity .5s; }
  .d3 :global(.vn-both.on) { opacity: .85; }
  .d3 :global(.failing .vn-c) { opacity: .3; stroke-dasharray: 6 6; }
  .d3 :global(.vn-label) { font: 800 17px var(--font-sans); fill: var(--ink); }
  .d3 :global(.vn-item) { font: 500 13px var(--font-sans); fill: var(--ink-2); }
  .d3 :global(.vn-mid) { transition: opacity .5s; }
  .d3 :global(.vn-both-label) { font: 800 16px var(--font-sans); fill: var(--paper); }
  .d3 :global(.vn-both-desc) { font: 600 11px var(--font-sans); fill: var(--paper); }
  .d3 :global(.vn-fail) { font: 800 15px var(--font-sans); fill: var(--ink); opacity: 0; transition: opacity .4s; }

  /* balance */
  .d3 :global(.bl-era) { font: 800 22px var(--font-sans); fill: var(--ink); }
  .d3 :global(.bl-en) { font: 700 12px var(--font-mono); fill: var(--accent-ink); }
  .d3 :global(.bl-desc) { font: 500 13px var(--font-sans); fill: var(--ink-2); }
  .d3 :global(.bl-fulcrum) { fill: var(--ink); }
  .d3 :global(.bl-ground) { stroke: var(--ink-3); stroke-width: 2; }
  .d3 :global(.bl-beam) { transition: transform 1.1s var(--ease-spring); }
  .d3 :global(.bl-beam > rect) { fill: var(--ink-2); }
  /* 拖曳彩蛋：拖曳與回彈期間由 tick 逐格控制，關掉 transition 才不會拖泥帶水 */
  .d3 :global(.bl-free .bl-beam) { transition: none; }
  .d3 :global(.bl-dragging .bl-weight) { transition: none; }
  .d3 :global(.bl-drag) { cursor: grab; touch-action: none; }
  .d3 :global(.bl-dragging .bl-drag) { cursor: grabbing; }
  .d3 :global(.bl-egg) { font: 700 12px var(--font-sans); fill: var(--accent-ink); opacity: 0; transition: opacity .3s; pointer-events: none; }
  .d3 :global(.bl-dragging .bl-egg) { opacity: 1; }
  .d3 :global(.bl-weight) { transition: x .8s, y .8s, width .8s, height .8s; }
  .d3 :global(.bl-side.l .bl-weight) { fill: var(--accent); stroke: var(--accent-ink); stroke-width: 2; }
  .d3 :global(.bl-side.r .bl-weight) { fill: var(--paper-2); stroke: var(--ink-2); stroke-width: 2; }
  .d3 :global(.bl-side.has-tip:hover .bl-weight) { stroke: var(--ink); stroke-width: 3; }
  .d3 :global(.bl-label) { font: 800 14px var(--font-sans); fill: var(--ink); transition: y .8s; }
  .d3 :global(.bl-timeline line) { stroke: var(--line); stroke-width: 3; }
  .d3 :global(.bl-node circle) { fill: var(--paper); stroke: var(--ink-3); stroke-width: 3; transition: fill .4s; }
  .d3 :global(.bl-node.on circle) { fill: var(--accent-ink); stroke: var(--accent-ink); }
  .d3 :global(.bl-node text) { font: 700 13px var(--font-sans); fill: var(--ink-2); }
  .d3 :global(.bl-node.on text) { fill: var(--ink); }
  .d3 :global(.bl-node .bl-years) { font: 500 11px var(--font-mono); fill: var(--ink-3); }

  /* allocate */
  .d3 :global(.al-h) { font: 800 15px var(--font-sans); fill: var(--ink); }
  .d3 :global(.al-tag) { font: 500 11px var(--font-sans); fill: var(--ink-3); }
  .d3 :global(.al-rows), .d3 :global(.al-out) { opacity: 0; pointer-events: none; transition: opacity .5s; }
  .d3 :global(.al-rows.on), .d3 :global(.al-out.on) { opacity: 1; pointer-events: auto; }
  .d3 :global(.al-hit) { fill: transparent; }
  .d3 :global(.al-row.has-tip:hover .al-hit), .d3 :global(.al-row.has-tip:focus-visible .al-hit) { fill: rgba(0, 0, 0, .05); stroke: var(--ink-3); }
  .d3 :global(.al-label) { font: 700 13px var(--font-sans); fill: var(--ink-2); }
  .d3 :global(.al-row.main .al-label) { font-size: 15px; font-weight: var(--fw-bold); fill: var(--accent-ink); }
  .d3 :global(.al-dots) { transition: opacity .5s; }
  .d3 :global(.al-dots:not(.on)) { opacity: 0; }
  .d3 :global(.al-dots circle) { fill: var(--accent-ink); transition: transform .9s cubic-bezier(.3,.7,.2,1); }
  .d3 :global(.al-emit) { font: 700 12px var(--font-sans); fill: var(--ink-2); }
  .d3 :global(.al-emitter) { fill: var(--ink); }
  .d3 :global(.al-zone-bg) { fill: var(--paper-2); }
  .d3 :global(.al-zone.has-tip:hover .al-zone-bg) { stroke: var(--ink); stroke-width: 2; }
  .d3 :global(.al-floor) { stroke: var(--ink-3); stroke-width: 2; }
  .d3 :global(.al-zone-t) { font: 800 14px var(--font-sans); fill: var(--ink); }
  .d3 :global(.al-bar) { fill: var(--accent-ink); pointer-events: none; }
  .d3 :global(.al-p) { fill: var(--ink-3); pointer-events: none; }
  .d3 :global(.al-p.keep) { fill: var(--accent-ink); }

  /* rings */
  .d3 :global(.rg-ring circle) { stroke: var(--paper); stroke-width: 3; transition: fill .2s; }
  .d3 :global(.rg-0 circle) { fill: color-mix(in srgb, var(--accent) 100%, var(--paper)); }
  .d3 :global(.rg-1 circle) { fill: color-mix(in srgb, var(--accent) 72%, var(--paper)); }
  .d3 :global(.rg-2 circle) { fill: color-mix(in srgb, var(--accent) 48%, var(--paper)); }
  .d3 :global(.rg-3 circle) { fill: color-mix(in srgb, var(--accent) 26%, var(--paper)); }
  .d3 :global(.rg-ring.has-tip:hover circle), .d3 :global(.rg-ring.has-tip:focus-visible circle) { fill: var(--accent-ink); }
  .d3 :global(.rg-ring.has-tip:hover text), .d3 :global(.rg-ring.has-tip:focus-visible text) { fill: var(--paper); }
  .d3 :global(.rg-label) { font: 800 14px var(--font-sans); fill: var(--ink); pointer-events: none; }
  .d3 :global(.rg-sub) { font: 500 10px var(--font-sans); fill: var(--ink-2); pointer-events: none; }
  .d3 :global(.rg-core circle) { fill: var(--ink); }
  .d3 :global(.rg-core text) { font: 800 16px var(--font-sans); fill: var(--paper); }
