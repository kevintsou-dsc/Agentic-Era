---
// 插畫場景：作者小故事、個人經驗這類「不是統計數據」的內容，用分格插畫陪讀者捲過去。
// art 對應 src/components/art/ 下的元件；每格以 data-focus 對應第幾段主文。
import type { Graphic } from '../../lib/story';
import MagnetMount from '../art/MagnetMount.astro';
import Escalation from '../art/Escalation.astro';
import PersonaDuo from '../art/PersonaDuo.astro';
import AgentTeam from '../art/AgentTeam.astro';
import JourneyCompress from '../art/JourneyCompress.astro';
import JudgmentSources from '../art/JudgmentSources.astro';
import IProof from '../art/IProof.astro';
import MediaPP from '../art/MediaPP.astro';
import Pillars from '../art/Pillars.astro';
import CcsModel from '../art/CcsModel.astro';
import AiPi from '../art/AiPi.astro';
import E2eRings from '../art/E2eRings.astro';
import Foundation from '../art/Foundation.astro';
import GrowthTriangle from '../art/GrowthTriangle.astro';
import CoffeeLayers from '../art/CoffeeLayers.astro';
import ContentEngine from '../art/ContentEngine.astro';
type G = Extract<Graphic, { type: 'art' }>;
interface Props { g: G }
const { g } = Astro.props;
// 寬版插畫在手機上太小：顯示「放大看全圖」按鈕（scripts/zoom.ts）
const zoomable = g.art === 'e2e-rings' || g.art === 'iproof' || g.art === 'growth-triangle';
---
<figure class="stage art">
  {g.title && <p class="title">{g.title}</p>}
  {g.art === 'magnet-mount' && <MagnetMount />}
  {g.art === 'escalation' && <Escalation />}
  {g.art === 'persona-duo' && <PersonaDuo />}
  {g.art === 'agent-team' && <AgentTeam />}
  {g.art === 'journey-compress' && <JourneyCompress />}
  {g.art === 'judgment-sources' && <JudgmentSources />}
  {g.art === 'iproof' && <div class="art-zoomable" data-zoom-src data-zoom><IProof /></div>}
  {g.art === 'media-pp' && <MediaPP />}
  {g.art === 'pillars' && <Pillars />}
  {g.art === 'ccs-model' && <CcsModel />}
  {g.art === 'ai-pi' && <AiPi />}
  {g.art === 'e2e-rings' && <div class="art-zoomable" data-zoom-src data-zoom><E2eRings /></div>}
  {g.art === 'foundation' && <Foundation />}
  {g.art === 'growth-triangle' && <div class="art-zoomable" data-zoom-src data-zoom><GrowthTriangle /></div>}
  {g.art === 'coffee-layers' && <CoffeeLayers />}
  {g.art === 'content-engine' && <ContentEngine />}
  {zoomable && <button type="button" class="zoom-btn" data-zoom aria-label="放大看全圖">⤢ 點此放大看全圖</button>}
  <figcaption class="source">{g.source}</figcaption>
</figure>
<style>
  .art { width: 100%; margin: 0; display: grid; gap: 10px; }
  .title { margin: 0; font-weight: var(--fw-bold); font-size: clamp(17px, 1.4vw + 10px, 22px); }
</style>
