---
// Share of Choice Context 三個層次（吳宗霖〈重建 SOV〉p.123–124）
const layers = [
  { en: 'System Share', zh: '品牌在平台、通路與生活系統中的可見位置', ex: '搜尋結果、電商站內排序、AI 搜尋摘要，也包括門市、貨架與生活動線' },
  { en: 'Consumer & Community Share', zh: '品牌在消費者與社群心中的份額', ex: '不是誰發文最多，而是討論某個需求時，誰會自然被提起' },
  { en: 'Attention & Memory Share', zh: '品牌在注意力與記憶中的份額', ex: '消費者是否在某個情境下會想起品牌' },
];
---
<div class="stage sov ch-model">
  <p class="title"><span class="from">Share of Voice</span><span class="arrow">→</span><b>Share of Choice Context</b></p>
  <ol class="stack">
    {layers.map((l, i) => (
      <li class={`layer k${i + 1}`}>
        <span class="en">{l.en}</span>
        <span class="zh">{l.zh}</span>
        <span class="ex">{l.ex}</span>
      </li>
    ))}
  </ol>
  <p class="source">整理：策展者｜依據 吳宗霖〈重建 SOV〉紙本 p.123–124</p>
</div>
<style>
  .sov { width: 100%; display: grid; gap: 14px; }
  .title { margin: 0; font-size: clamp(18px, 1.6vw + 10px, 24px); display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; }
  .from { color: var(--ink-3); text-decoration: line-through; text-decoration-thickness: 2px; }
  .arrow { color: var(--ink-3); }
  .stack { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .layer { display: grid; gap: 2px; padding: 14px 18px; border-radius: 12px; border: 2px solid var(--line); background: var(--paper); opacity: .3; transform: translateX(-12px); transition: opacity .5s, transform .5s, background .5s, border-color .5s; }
  .en { font-weight: 800; font-size: 17px; }
  .zh { font-size: 15px; }
  .ex { font-size: 13px; color: var(--ink-2); max-height: 0; overflow: hidden; transition: max-height .5s; }
  :global(.graphic.is-1) .k1, :global(.graphic.is-2) .k2, :global(.graphic.is-3) .k3 { opacity: 1; transform: none; background: var(--model); border-color: var(--model-ink); }
  :global(.graphic[data-step="1"]) .k1 .ex, :global(.graphic[data-step="2"]) .k2 .ex, :global(.graphic[data-step="3"]) .k3 .ex { max-height: 4em; }
</style>
