---
// 時間軸的「電車」造型（a20 品牌競爭力的三次遷移）：每個階段一節車廂，列車往左駛，
// 第 k 段主文時第 k 節車廂停進畫面中央的月台並亮起，站牌顯示這一站。標題「階段｜名稱」拆成站牌與車廂名。
// 位移由 .graphic 的累進步驟類別決定（--k = 已到站數 − 1）。class 一律加 tr- 前綴。
import type { Graphic } from '../../../lib/story';
type G = Extract<Graphic, { type: 'list' }>;
interface Props { g: G }
const { g } = Astro.props;
const n = g.items.length;
const split = (t: string) => (t.includes('｜') ? t.split('｜') : [String(t), '']);
---
<div class="tr" style={`--n:${n}`}>
  <div class="tr-signs" aria-hidden="true">
    {g.items.map((it, i) => <span class="tr-sign" data-focus={it.at ?? i + 1}>本站　{split(it.title)[0]}</span>)}
  </div>
  <div class="tr-view">
    <ol class="tr-train">
      {g.items.map((it, i) => {
        const [phase, name] = split(it.title);
        return (
          <li class:list={['tr-car', { 'tr-head': i === 0 }]} data-at={it.at ?? i + 1} data-focus={it.at ?? i + 1}>
            <span class="tr-roof" aria-hidden="true"></span>
            <span class="tr-windows" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="tr-body">
              <em>{phase}</em>
              <b>{name || phase}</b>
              {it.desc && <span>{it.desc}</span>}
            </span>
            <span class="tr-wheels" aria-hidden="true"><i></i><i></i></span>
          </li>
        );
      })}
    </ol>
    <span class="tr-rail" aria-hidden="true"></span>
    <span class="tr-platform" aria-hidden="true"></span>
  </div>
</div>
<style>
  .tr { --car: 62%; --gap: 4%; display: grid; gap: 10px; }
  .tr-signs { display: grid; justify-items: center; }
  .tr-sign { grid-area: 1 / 1; padding: 4px 14px; border-radius: 6px; background: var(--ink); color: var(--paper); font-size: 13px; font-weight: var(--fw-bold); letter-spacing: .06em; opacity: var(--focus); transition: opacity .4s; }
  :global(.graphic:not(.is-1)) .tr-sign:first-child { opacity: 1; }
  .tr-view { position: relative; overflow: hidden; padding: 26px 0 30px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .tr-train { --k: 0; list-style: none; margin: 0; padding: 0; display: flex; gap: var(--gap); transform: translateX(calc(50% - var(--car) / 2 - var(--k) * (var(--car) + var(--gap)))); transition: transform 1.1s cubic-bezier(.45, 0, .2, 1); }
  :global(.graphic.is-2) .tr-train { --k: 1; }
  :global(.graphic.is-3) .tr-train { --k: 2; }
  :global(.graphic.is-4) .tr-train { --k: 3; }
  :global(.graphic.is-5) .tr-train { --k: 4; }
  .tr-car { position: relative; flex: 0 0 var(--car); display: grid; gap: 6px; padding: 14px 14px 18px; border-radius: 10px 10px 6px 6px; border: 2px solid var(--ink);
    background: color-mix(in srgb, var(--accent) calc(var(--focus) * 100%), color-mix(in srgb, var(--ink) 6%, var(--paper))); opacity: calc(.45 + .55 * var(--on)); transition: background .5s, opacity .5s; }
  .tr-head { border-radius: 30px 10px 6px 6px; }
  .tr-car + .tr-car::before { content: ''; position: absolute; left: calc(-1 * var(--gap) - 2px); width: calc(var(--gap) + 2px); bottom: 26px; height: 6px; background: var(--ink); }
  .tr-roof { position: absolute; left: 18%; right: 18%; top: -10px; height: 8px; border: 2px solid var(--ink); border-bottom: 0; border-radius: 6px 6px 0 0; background: var(--paper); }
  .tr-windows { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .tr-windows i { height: 22px; border-radius: 4px; border: 2px solid var(--ink); background: color-mix(in srgb, #fff 70%, var(--paper)); }
  .tr-body { display: grid; gap: 2px; }
  .tr-body em { font-style: normal; font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); }
  .tr-body b { font-size: 17px; line-height: 1.35; }
  .tr-body span { font-size: 13px; line-height: 1.5; color: var(--ink-2); }
  .tr-wheels { position: absolute; left: 12%; right: 12%; bottom: -13px; display: flex; justify-content: space-between; }
  .tr-wheels i { width: 18px; height: 18px; border-radius: 50%; background: var(--ink); border: 3px solid var(--paper); box-shadow: 0 0 0 2px var(--ink); }
  .tr-rail { position: absolute; left: 0; right: 0; bottom: 14px; height: 3px; background: var(--ink-2); }
  .tr-platform { position: absolute; left: 50%; bottom: 0; width: calc(var(--car) + 4%); height: 10px; transform: translateX(-50%); background: repeating-linear-gradient(90deg, var(--ink-3) 0 10px, transparent 10px 16px); opacity: .5; }
  @media (prefers-reduced-motion: reduce) { .tr-train { transition: none; } }
</style>
