---
// 自願性注意力相較強迫性注意力的品牌回想增幅：注視 5–10 秒 +18%、注視 > 10 秒 +79%
// 徐莉媛〈別買曝光了〉p.77 圖4，資料來源 dentsu Japan International Brands《Introducing the Attention Economy》
const bars = [
  { label: '注視 5–10 秒', value: 18, cls: 'b1' },
  { label: '注視 > 10 秒', value: 79, cls: 'b2' },
];
const max = 90;
---
<div class="stage att">
  <p class="title">同樣的秒數，「自己選擇看」比「被迫看」值錢得多</p>
  <div class="chart" role="img" aria-label="自願觀看相較被迫觀看的品牌回想增幅：注視 5 到 10 秒為加 18%，注視超過 10 秒為加 79%">
    {bars.map((b) => (
      <div class={`col ${b.cls}`}>
        <span class="v">+{b.value}%</span>
        <div class="bar" style={`--h:${b.value / max}`}></div>
        <span class="l">{b.label}</span>
      </div>
    ))}
  </div>
  <p class="axis">自願性注意力相較強迫性注意力的品牌回想增幅（%）</p>
  <p class="source">資料來源 dentsu Japan International Brands《Introducing the Attention Economy》眼動研究，引自 徐莉媛〈別買曝光了〉紙本 p.77</p>
</div>
<style>
  .att { width: 100%; display: grid; gap: 10px; }
  .title { margin: 0; font-weight: 700; font-size: clamp(17px, 1.4vw + 10px, 22px); }
  .chart { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: end; height: min(42svh, 340px); border-bottom: 2px solid var(--ink); padding: 0 12%; }
  .col { display: flex; flex-direction: column; justify-content: flex-end; height: 100%; text-align: center; position: relative; }
  .bar { height: calc(var(--h) * (100% - 3.2rem)); flex: none; background: var(--accent); border: 2px solid var(--accent-ink); border-bottom: 0; border-radius: 8px 8px 0 0; transform-origin: bottom; transform: scaleY(0); transition: transform 1s cubic-bezier(.2,.7,.2,1); }
  .v { font-size: clamp(28px, 4vw, 48px); font-weight: 800; color: var(--accent-ink); opacity: 0; transition: opacity .5s .5s; line-height: 1.2; margin-bottom: 6px; }
  .l { position: absolute; bottom: -30px; left: 0; right: 0; font-size: 14px; color: var(--ink-2); }
  .axis { margin: 36px 0 0; font-size: 13px; color: var(--ink-2); }
  .b2 .bar { background: var(--accent-ink); }
  :global(.graphic.is-1) .b1 .bar, :global(.graphic.is-2) .b2 .bar { transform: scaleY(1); }
  :global(.graphic.is-1) .b1 .v, :global(.graphic.is-2) .b2 .v { opacity: 1; }
</style>
