---
// 原刊表格的網頁版：欄位標題＋逐列，第 k 段主文點亮第 at 列（其他列淡出但仍可讀）。
// 第一欄可寫「主標｜副標」；icon 依原表的列圖示。窄螢幕改成一列一張卡、欄位名稱放在格子上方。
// 儲存格內用「、」以外的換行請寫 \n（轉成條列）。class 一律加 tb- 前綴。
import type { Graphic } from '../../lib/story';
type G = Extract<Graphic, { type: 'table' }>;
interface Props { g: G }
const { g } = Astro.props;
const split = (t: string) => (t.includes('｜') ? t.split('｜') : [t, '']);
---
<div class="stage tb" style={`--c:${g.cols.length}`}>
  {g.title && <p class="title">{g.title}</p>}
  <div class="tb-grid" role="table" aria-label={g.title ?? g.source}>
    <div class="tb-row tb-head" role="row">
      {g.cols.map((c) => <span role="columnheader">{c}</span>)}
    </div>
    {g.rows.map((r) => (
      <div class="tb-row" role="row" data-at={r.at} data-focus={r.at}>
        {r.cells.map((cell, ci) => {
          const [main, sub] = split(cell);
          return ci === 0 ? (
            <span class="tb-first" role="rowheader">
              {r.icon && (
                <svg class="tb-ic" viewBox="0 0 40 40" aria-hidden="true">
                  {r.icon === 'question' && <g><path d="M15 13 q0 -7 7 -7 q7 0 7 6 q0 5 -6 7 v4" /><circle cx="23" cy="29" r="1.6" class="tb-fill" /><path d="M8 38 v-8 q0 -4 4 -4 h3" /></g>}
                  {r.icon === 'blocks' && <g><circle cx="20" cy="20" r="15" stroke-dasharray="3 4" /><rect x="11" y="10" width="7" height="7" rx="2" /><rect x="22" y="10" width="7" height="7" rx="2" /><rect x="11" y="23" width="7" height="7" rx="2" /><rect x="22" y="23" width="7" height="7" rx="2" /><path d="M18 18 l4 4 M22 18 l-4 4" class="tb-red" /></g>}
                  {r.icon === 'arrows' && <g><path d="M4 20 h18" /><path d="M22 20 l12 -10 M22 20 l12 0 M22 20 l12 10" class="tb-red" /><path d="M30 8 l4 2 l-2 4 M31 18 l3 2 l-3 2 M32 26 l2 4 l-4 0" class="tb-red" /></g>}
                  {r.icon === 'data' && <g><ellipse cx="20" cy="10" rx="11" ry="4" /><path d="M9 10 v20 q11 7 22 0 v-20 M9 20 q11 7 22 0" /></g>}
                  {r.icon === 'gear' && <g><circle cx="20" cy="20" r="6" /><path d="M20 5 v5 M20 30 v5 M5 20 h5 M30 20 h5 M9 9 l4 4 M27 27 l4 4 M31 9 l-4 4 M13 27 l-4 4" /></g>}
                </svg>
              )}
              <span><b>{main}</b>{sub && <em>{sub}</em>}</span>
            </span>
          ) : (
            <span class="tb-cell" role="cell" data-col={g.cols[ci]}>
              {cell.includes('\n') ? <ul>{cell.split('\n').map((li) => <li>{li}</li>)}</ul> : cell}
            </span>
          );
        })}
      </div>
    ))}
  </div>
  <p class="source">{g.source}</p>
</div>
<style>
  .tb { width: 100%; display: grid; gap: 12px; }
  .title { margin: 0; font-weight: var(--fw-bold); font-size: clamp(18px, 1.6vw + 10px, 24px); }
  .tb-grid { display: grid; gap: 8px; padding: 10px; border-radius: 12px; background: color-mix(in srgb, var(--ink) 8%, var(--paper)); }
  .tb-row { display: grid; grid-template-columns: 1.15fr repeat(calc(var(--c) - 1), 1fr); gap: 0; border-radius: 8px; background: var(--paper);
    opacity: calc(.35 + .65 * var(--on)); box-shadow: inset 0 0 0 calc(var(--focus) * 2px) var(--accent-ink); transition: opacity .5s, box-shadow .4s; }
  .tb-row > span { padding: 12px 12px; font-size: 13px; line-height: 1.6; color: var(--ink-2); }
  .tb-row > span + span { border-left: 1px dashed var(--line); }
  .tb-head { background: none; opacity: 1; box-shadow: none; }
  .tb-head > span { padding: 4px 12px 2px; font-size: 14px; font-weight: var(--fw-bold); color: var(--ink); text-align: center; border: 0 !important; }
  .tb-first { display: flex; align-items: center; gap: 10px; }
  .tb-first b { display: block; font-size: 16px; color: var(--accent-ink); line-height: 1.35; }
  .tb-first em { display: block; font-style: normal; font-size: 12px; color: var(--ink-3); }
  .tb-ic { flex: none; width: 40px; height: 40px; fill: none; stroke: var(--ink); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .tb-red { stroke: var(--accent-ink); }
  .tb-fill { fill: var(--ink); stroke: none; }
  .tb-cell ul { margin: 0; padding-left: 1.1em; }
  .tb-cell li::marker { color: var(--accent-ink); }
  @media (max-width: 560px) {
    .tb-head { display: none; }
    .tb-row { grid-template-columns: 1fr; }
    .tb-row > span + span { border-left: 0; border-top: 1px dashed var(--line); }
    .tb-cell::before { content: attr(data-col); display: block; font-size: 11px; font-weight: var(--fw-bold); color: var(--ink-3); }
  }
</style>
