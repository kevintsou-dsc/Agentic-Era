---
// 近三屆金曲獎電視平均收視：2024 2.78、2025 2.31、2026 3.37（吳宗霖、陳炯文〈從金曲獎到甄嬛傳〉p.84 圖2，資料來源 Nielsen Arianna／dentsu X 分析）
const years = [
  { y: '2024', n: '第 35 屆', v: 2.78, cls: 'y24' },
  { y: '2025', n: '第 36 屆', v: 2.31, cls: 'y25' },
  { y: '2026', n: '第 37 屆', v: 3.37, cls: 'y26' },
];
const max = 3.8;
---
<div class="stage golden">
  <p class="title">近三屆金曲獎電視平均收視 <span class="delta">2026 較前一年 +46%</span></p>
  <div class="chart" role="img" aria-label="金曲獎電視平均收視：2024 年 2.78，2025 年 2.31，2026 年 3.37，較前一年成長約 46%">
    {years.map((d) => (
      <div class={`col ${d.cls}`}>
        <span class="v">{d.v.toFixed(2)}</span>
        <div class="bar" style={`--h:${d.v / max}`}></div>
        <span class="l">{d.y}<br /><small>{d.n}</small></span>
      </div>
    ))}
  </div>
  <p class="source">資料來源 Nielsen Arianna／dentsu X 分析，引自 吳宗霖、陳炯文〈從金曲獎到甄嬛傳〉紙本 p.84</p>
</div>
<style>
  .golden { width: 100%; display: grid; gap: 10px; }
  .title { margin: 0; font-weight: 700; font-size: clamp(17px, 1.4vw + 10px, 22px); }
  .chart { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: end; height: min(40svh, 320px); border-bottom: 2px solid var(--ink); padding: 0 6%; margin-bottom: 44px; }
  .col { display: flex; flex-direction: column; justify-content: flex-end; height: 100%; text-align: center; position: relative; }
  .bar { height: calc(var(--h) * (100% - 2.6rem)); flex: none; background: var(--paper-2); border: 2px solid var(--ink-3); border-bottom: 0; border-radius: 8px 8px 0 0; transform-origin: bottom; transform: scaleY(0); transition: transform 1s cubic-bezier(.2,.7,.2,1); }
  .y26 .bar { background: var(--accent); border-color: var(--accent-ink); }
  .v { font-size: clamp(20px, 2.6vw, 32px); font-weight: 800; opacity: 0; transition: opacity .5s .4s; font-variant-numeric: tabular-nums; line-height: 1.2; margin-bottom: 6px; }
  .y26 .v { color: var(--accent-ink); }
  .l { position: absolute; bottom: -44px; left: 0; right: 0; font-size: 14px; color: var(--ink-2); line-height: 1.3; font-family: var(--font-mono); }
  .l small { font-family: var(--font-sans); font-size: 12px; color: var(--ink-3); }
  .title { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; }
  .delta { font-size: clamp(16px, 1.6vw + 8px, 22px); font-weight: 800; color: var(--accent-ink); background: var(--accent); padding: 0 10px; border-radius: 999px; opacity: 0; transform: translateY(8px); transition: opacity .5s, transform .5s; }
  :global(.graphic.is-1) .y24 .bar, :global(.graphic.is-1) .y25 .bar { transform: scaleY(1); }
  :global(.graphic.is-1) .y24 .v, :global(.graphic.is-1) .y25 .v { opacity: 1; }
  :global(.graphic.is-2) .y26 .bar { transform: scaleY(1); }
  :global(.graphic.is-2) .y26 .v { opacity: 1; }
  :global(.graphic.is-3) .delta { opacity: 1; transform: none; }
</style>
