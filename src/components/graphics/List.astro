---
// 清單型框架：第 k 步出現第 k 項（或用 at 讓多項同一步出現），當下那幾項加重
// flip：翻面卡，正面是 title（表象），hover／聚焦／點按翻到背面看 desc（真因）
import type { Graphic } from '../../lib/story';
import MoreRef from '../MoreRef.astro';
import Tram from './list/Tram.astro';
import Polaroid from './list/Polaroid.astro';
import Hanger from './list/Hanger.astro';
import Vs from './list/Vs.astro';
import Radial from './list/Radial.astro';
import Checklist from './list/Checklist.astro';
import Flatten from './list/Flatten.astro';
import Scatter from './list/Scatter.astro';
type G = Extract<Graphic, { type: 'list' }>;
interface Props { g: G }
const { g } = Astro.props;
// 所有項目同一步出現（主文沒有逐項對應）時，不做逐段加重，整張清單一起顯示
const together = new Set(g.items.map((it, i) => it.at ?? i + 1)).size === 1;
// 排列（docs/story-guide.md §5「卡片組排列」）：
//   ≤3 張：一欄；卡片內容很短（偏窄）時三欄。
//   5 張：內容都短（高度不高）時一欄，否則兩欄、最後一張橫跨兩欄。
//   其他：兩欄；奇數張時最後一張橫跨兩欄，不留缺口。
//   layout 可手動指定（one／two／three），意象更適合其他排法時改用 cycle 等圖表。
const n = g.items.length;
const len = (it: G['items'][number]) => it.title.length + (it.desc ?? '').length;
const short = g.items.every((it) => len(it) <= 24);
const brief = g.items.every((it) => len(it) <= 40);
const auto = n <= 3 ? (short ? 'three' : 'one') : n === 5 && brief ? 'one' : 'two';
const layout = g.layout ?? auto;
const span = layout === 'two' && n % 2 === 1;
// timeline：有先後順序的轉變。4 項以內橫向、5 項以上直向（手機一律直向）；標題「階段｜名稱」拆成節點標籤與卡片標題
const timeline = layout === 'timeline';
const vertical = n >= 5;
const phase = (t: string, i: number) => (t.includes('｜') ? t.split('｜')[0] : String(i + 1).padStart(2, '0'));
const name = (t: string) => (t.includes('｜') ? t.split('｜').slice(1).join('｜') : t);
---
<div class="stage list">
  {g.title && <p class="title">{g.title}</p>}
  {g.flip && <p class="hint">滑過或點按卡片，翻面看背後原因</p>}
  {layout === 'tram' ? <Tram g={g} /> : layout === 'polaroid' ? <Polaroid g={g} /> : layout === 'hanger' ? <Hanger g={g} />
    : layout === 'vs' ? <Vs g={g} /> : layout === 'radial' ? <Radial g={g} /> : layout === 'checklist' ? <Checklist g={g} />
    : layout === 'flatten' ? <Flatten g={g} /> : layout === 'scatter' ? <Scatter g={g} /> : timeline ? (
    <ol class:list={['tl', { 'tl-v': vertical, together }]} style={`--n:${n}`}>
      {g.items.map((it, i) => (
        <li data-at={it.at ?? i + 1} data-focus={together ? undefined : (it.at ?? i + 1)} class:list={{ 'tl-last': i === n - 1 }}>
          <span class="tl-node"><span class="tl-dot"></span><span class="tl-phase">{phase(it.title, i)}</span></span>
          <span class="tl-card">
            <span class="t">{name(it.title)}</span>
            {it.desc && <span class="d">{it.desc}</span>}
            <MoreRef m={it.more} overlay />
          </span>
        </li>
      ))}
    </ol>
  ) : (
  <ol class:list={['items', `cols-${layout}`, { together, 'fc-set': g.flip, 'span-last': span }]} style={`--n:${g.items.length}`}>
    {g.items.map((it, i) => g.flip ? (
      <li data-at={it.at ?? i + 1} data-focus={together ? undefined : (it.at ?? i + 1)} tabindex="0" aria-label={`${it.title}：${it.desc ?? ''}`}>
        <div class="fc-card">
          <div class="fc-face fc-front" aria-hidden="true">
            <span class="no">{String(i + 1).padStart(2, '0')}</span>
            <span class="fc-tag">看似</span>
            <span class="t">{it.title.replace(/^看似/, '')}</span>
            <span class="fc-turn">翻面 ↻</span>
          </div>
          <div class="fc-face fc-back" aria-hidden="true">
            <span class="no">{String(i + 1).padStart(2, '0')}</span>
            <span class="fc-tag">背後</span>
            <span class="t">{(it.desc ?? '').replace(/^背後(其實|可能)?是/, '')}</span>
          </div>
        </div>
      </li>
    ) : (
      <li data-at={it.at ?? i + 1} data-focus={together ? undefined : (it.at ?? i + 1)} >
        <span class="no">{String(i + 1).padStart(2, '0')}</span>
        <span class="t">{it.title}</span>
        {it.desc && <span class="d">{it.desc}</span>}
        <MoreRef m={it.more} overlay />
      </li>
    ))}
  </ol>
  )}
  <p class="source">{g.source}</p>
</div>
<style>
  .list { width: 100%; display: grid; gap: 14px; }
  .title { margin: 0; font-weight: 700; font-size: clamp(18px, 1.6vw + 10px, 24px); }
  .hint { margin: -8px 0 0; font-size: 13px; color: var(--ink-3); }
  .items { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 10px; }
  .cols-two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cols-three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .span-last > li:last-child { grid-column: 1 / -1; }
  @media (max-width: 560px) { .cols-two, .cols-three { grid-template-columns: 1fr; } }
  li { position: relative; display: grid; gap: 2px; align-content: start; padding: 12px 14px; border-radius: 12px; border: 2px solid color-mix(in srgb, var(--accent-ink) calc(var(--focus) * 100%), var(--line)); background: color-mix(in srgb, var(--accent) calc(var(--focus) * 100%), var(--paper)); opacity: calc(.2 + .8 * var(--on)); transform: translateY(calc((1 - var(--on)) * 10px)); transition: opacity .5s, transform .5s, background .4s, border-color .4s; }
  .together li { --focus: 0; border-color: var(--ink-3); }
  .no { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); }
  .t { font-weight: 800; font-size: 16px; line-height: 1.4; }
  .d { font-size: 13px; color: var(--ink-2); line-height: 1.5; }

  /* 時間軸：軌道在節點列，跟著第 k 段點亮到第 k 個節點；最後一段帶箭頭 */
  .tl { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 0 12px; }
  /* 時間軸的項目不是卡片：重設一般清單 li 的外框、底色與內距 */
  .tl li { position: relative; display: grid; grid-template-rows: auto 1fr; gap: 10px; padding: 0; border: 0; border-radius: 0; background: none; transform: none; opacity: calc(.25 + .75 * var(--on)); transition: opacity .5s; }
  .tl-node { position: relative; display: flex; align-items: center; gap: 8px; height: 28px; }
  .tl li::before { content: ''; position: absolute; top: 13px; left: 0; right: -12px; height: 3px; border-radius: 2px;
    background: linear-gradient(90deg, var(--accent-ink) calc(var(--on) * 100%), var(--line) 0); transition: background .6s; }
  .tl li.tl-last::before { right: 10px; }
  .tl li.tl-last::after { content: ''; position: absolute; top: 8px; right: 0; border: 7px solid transparent; border-right: 0; border-left: 11px solid color-mix(in srgb, var(--accent-ink) calc(var(--on) * 100%), var(--line)); }
  .tl-dot { position: relative; z-index: 1; flex: none; width: 20px; height: 20px; border-radius: 50%; border: 3px solid color-mix(in srgb, var(--accent-ink) calc(var(--on) * 100%), var(--line)); background: color-mix(in srgb, var(--accent) calc(var(--focus) * 100%), var(--paper));
    box-shadow: 0 0 0 calc(var(--focus) * 6px) color-mix(in srgb, var(--accent) 50%, transparent); transition: box-shadow .4s, background .4s, border-color .4s; }
  .tl-phase { position: relative; z-index: 1; padding: 0 6px; background: var(--paper); font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--ink-2); white-space: nowrap; }
  .tl-card { position: relative; display: grid; gap: 4px; align-content: start; padding: 12px 14px; border-radius: 12px; border: 2px solid color-mix(in srgb, var(--accent-ink) calc(var(--focus) * 100%), var(--ink-3));
    background: color-mix(in srgb, var(--accent) calc(var(--focus) * 100%), var(--paper)); transform: translateY(calc((1 - var(--on)) * 10px)); transition: transform .5s, background .4s, border-color .4s; }
  .together .tl-card { --focus: 0; }
  /* 直向：軌道在左側 */
  .tl-v, .tl-v li { grid-template-columns: 1fr; }
  .tl-v { gap: 12px; }
  .tl-v li { grid-template-columns: 20px 1fr; grid-template-rows: auto; column-gap: 14px; }
  .tl-v .tl-node { flex-direction: column; align-items: center; height: auto; padding-top: 12px; }
  .tl-v .tl-phase { display: none; }
  .tl-v li::before { top: 12px; bottom: -12px; left: 8.5px; right: auto; width: 3px; height: auto; background: linear-gradient(180deg, var(--accent-ink) calc(var(--on) * 100%), var(--line) 0); }
  .tl-v li.tl-last::before { bottom: 10px; }
  .tl-v li.tl-last::after { top: auto; bottom: 0; right: auto; left: 3px; border: 7px solid transparent; border-bottom: 0; border-top: 11px solid color-mix(in srgb, var(--accent-ink) calc(var(--on) * 100%), var(--line)); }
  @media (max-width: 560px) {
    .tl { grid-template-columns: 1fr; gap: 12px; }
    .tl li { grid-template-columns: 20px 1fr; grid-template-rows: auto; column-gap: 14px; }
    .tl .tl-node { flex-direction: column; height: auto; padding-top: 12px; }
    .tl .tl-phase { display: none; }
    .tl li::before { top: 12px; bottom: -12px; left: 8.5px; right: auto; width: 3px; height: auto; background: linear-gradient(180deg, var(--accent-ink) calc(var(--on) * 100%), var(--line) 0); }
    .tl li.tl-last::before { bottom: 10px; }
    .tl li.tl-last::after { top: auto; bottom: 0; right: auto; left: 3px; border: 7px solid transparent; border-bottom: 0; border-top: 11px solid color-mix(in srgb, var(--accent-ink) calc(var(--on) * 100%), var(--line)); }
  }
  /* 翻面卡：兩面疊在同一格，卡高取兩面較高者；class 一律加 fc- 前綴，避免撞到全站 .card／.flip */
  .fc-set { grid-auto-rows: 1fr; }
  .fc-set li { align-content: stretch; padding: 0; border: 0; background: none; perspective: 900px; cursor: pointer; outline: none; }
  .fc-card { display: grid; height: 100%; min-height: 7.5rem; transform-style: preserve-3d; transition: transform .6s cubic-bezier(.2, .7, .2, 1); }
  .fc-face { grid-area: 1 / 1; display: grid; grid-template-rows: auto auto 1fr auto; gap: 4px; padding: 12px 14px; border-radius: 12px; border: 2px solid var(--ink-3); background: var(--paper); backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .fc-back { transform: rotateY(180deg); background: var(--accent); border-color: var(--accent-ink); }
  .fc-tag { justify-self: start; font-size: 12px; font-weight: 700; padding: 1px 8px; border-radius: 999px; border: 1px solid currentColor; color: var(--ink-2); }
  .fc-back .fc-tag { color: var(--accent-ink); }
  .fc-turn { justify-self: end; font-size: 12px; color: var(--ink-3); }
  .fc-set li:hover .fc-card, .fc-set li:focus-within .fc-card { transform: rotateY(180deg); }
  .fc-set li:focus-visible .fc-face { box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-ink) 40%, transparent); }
  @media (prefers-reduced-motion: reduce) {
    .fc-card { transform: none !important; transition: none; }
    .fc-face { backface-visibility: visible; transition: opacity .3s; }
    .fc-back { transform: none; opacity: 0; }
    .fc-set li:hover .fc-back, .fc-set li:focus-within .fc-back { opacity: 1; }
    .fc-set li:hover .fc-front, .fc-set li:focus-within .fc-front { opacity: 0; }
  }
</style>
