---
// 清單型框架：第 k 步出現第 k 項（或用 at 讓多項同一步出現），當下那幾項加重
import type { Graphic } from '../../lib/story';
import Tip from './Tip.astro';
type G = Extract<Graphic, { type: 'list' }>;
interface Props { g: G }
const { g } = Astro.props;
---
<div class="stage list">
  {g.title && <p class="title">{g.title}</p>}
  <ol class="items" style={`--n:${g.items.length}`}>
    {g.items.map((it, i) => (
      <li data-at={it.at ?? i + 1} data-focus={it.at ?? i + 1} data-tip={it.detail?.text}>
        <span class="no">{String(i + 1).padStart(2, '0')}<Tip d={it.detail} /></span>
        <span class="t">{it.title}</span>
        {it.desc && <span class="d">{it.desc}</span>}
      </li>
    ))}
  </ol>
  <p class="source">{g.source}</p>
</div>
<style>
  .list { width: 100%; display: grid; gap: 14px; }
  .title { margin: 0; font-weight: 700; font-size: clamp(18px, 1.6vw + 10px, 24px); }
  .items { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); gap: 10px; }
  li { display: grid; gap: 2px; align-content: start; padding: 12px 14px; border-radius: 12px; border: 2px solid color-mix(in srgb, var(--accent-ink) calc(var(--focus) * 100%), var(--line)); background: color-mix(in srgb, var(--accent) calc(var(--focus) * 100%), var(--paper)); opacity: calc(.2 + .8 * var(--on)); transform: translateY(calc((1 - var(--on)) * 10px)); transition: opacity .5s, transform .5s, background .4s, border-color .4s; }
  .no { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); }
  .t { font-weight: 800; font-size: 16px; line-height: 1.4; }
  .d { font-size: 13px; color: var(--ink-2); line-height: 1.5; }
</style>
