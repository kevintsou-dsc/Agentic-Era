---
// 案例圖片：第 k 段主文顯示第 k 張（疊放、淡入），圖說與原始連結（QR code 解出來的網址）跟著切換
import type { Graphic } from '../../lib/story';
type G = Extract<Graphic, { type: 'images' }>;
interface Props { g: G }
const { g } = Astro.props;
---
<div class="stage images">
  <div class="frame">
    {g.images.map((im, i) => (
      <figure class="pic" data-at={im.at} data-focus={im.at} style={`--z:${i}`}>
        <img src={im.src} alt={im.alt} width={im.w} height={im.h} style={im.w ? `max-width:${im.w}px` : undefined} loading="lazy" decoding="async" />
        <figcaption>
          {im.caption}{im.credit && <span class="credit">　{im.credit}</span>}
          {im.links?.map((l) => <a class="lnk" href={l.url} target="_blank" rel="noopener noreferrer">{l.kind === 'video' ? '看影片' : '看原始連結'}：{l.label} ↗</a>)}
        </figcaption>
      </figure>
    ))}
  </div>
  <p class="source">{g.source}</p>
</div>
<style>
  .images { width: 100%; display: grid; gap: 8px; }
  .frame { display: grid; }
  /* 疊放：不用底色（底色在紙紋上會變成一塊白底）。改為新的圖疊上來時，把下面每張舊圖的圖說藏起來，舊圖說就不會從縫隙露出 */
  .pic { grid-area: 1 / 1; margin: 0; display: grid; gap: 8px; align-content: start; padding-bottom: 4px; opacity: var(--on); transform: translateY(calc((1 - var(--on)) * 16px)) rotate(calc((var(--z) - 1) * .4deg)); transition: opacity .6s, transform .6s; z-index: var(--z); }
  figcaption { transition: opacity .3s; }
  :global(.graphic.is-2) .pic:has(~ .pic[data-at="2"]) figcaption, :global(.graphic.is-3) .pic:has(~ .pic[data-at="3"]) figcaption, :global(.graphic.is-4) .pic:has(~ .pic[data-at="4"]) figcaption, :global(.graphic.is-5) .pic:has(~ .pic[data-at="5"]) figcaption, :global(.graphic.is-6) .pic:has(~ .pic[data-at="6"]) figcaption, :global(.graphic.is-7) .pic:has(~ .pic[data-at="7"]) figcaption, :global(.graphic.is-8) .pic:has(~ .pic[data-at="8"]) figcaption { opacity: 0; visibility: hidden; }
  .pic img { width: 100%; height: auto; max-height: 52svh; object-fit: contain; border-radius: 12px; border: 2px solid var(--ink); background: var(--paper-2); box-shadow: 6px 6px 0 var(--accent); }
  figcaption { font-size: 13px; color: var(--ink-2); line-height: 1.6; }
  .credit { color: var(--ink-3); }
  .lnk { display: inline-block; margin-top: 4px; font-weight: 700; color: var(--accent-ink); }
</style>
