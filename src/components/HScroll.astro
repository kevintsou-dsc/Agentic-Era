---
// 橫向捲動區塊：區塊高度依格數拉長，內層固定在畫面上；讀者往下捲時，軌道依進度向左移動。
// 位移由 scripts/scrolly.ts 的 initHScroll 計算。矮視窗與「減少動態」時退回一般的左右滑動。
import type { Scene } from '../lib/story';
import { rich } from '../lib/rich';
import SourceRef from './SourceRef.astro';
import MoreRef from './MoreRef.astro';
import Notes from './Notes.astro';
import MoreBody from './MoreBody.astro';
import type { More } from '../lib/story';type S = Extract<Scene, { kind: 'hscroll' }>;
interface Props { s: S }
const { s } = Astro.props;
// 沒有案例圖片的格：細節攤在卡片上，一律可點擊展開／收合（scripts/expand.ts 平滑動畫）；
// 內容長（> 90 字）預設收起，內容短、卡片留白多時預設展開。不另開彈窗。
// 細節裡有圖片、卡片本身沒有時，把圖片升到卡片上，細節仍用彈窗。
const moreLen = (m: More) => (m.text ?? '').length + (m.quote?.text.length ?? 0);
const view = s.panels.map((p) => {
  const image = p.image ?? p.more?.image;
  const inline = !image && !!p.more;
  return { p, image, inline, fold: inline && moreLen(p.more!) > 90 };
});
// 同一組卡片的展開狀態要一致：只要有一張需要收起，整組都預設收起；
// 只有部分卡片有延伸區塊時也收起，避免單張卡片比同組其他張高出一截
const someInline = view.some((v) => v.inline), allInline = view.every((v) => v.inline || v.image);
if (view.some((v) => v.fold) || (someInline && !allInline)) view.forEach((v) => { v.fold = v.inline; });
---
<section class="hscroll" data-hscroll style={`--panels:${s.panels.length}`} aria-label={s.title}>
  <div class="hs-pin">
    <div class="hs-head wrap">
      <p class="eyebrow">{s.title}</p>
      <p class="hs-intro"><span set:html={rich(s.intro.text)} /><SourceRef src={s.intro.src} /><Notes notes={s.intro.notes} /></p>
    </div>
    <div class="hs-viewport">
      <ol class="hs-track" data-hs-track>
        {view.map(({ p, image, inline, fold }, i) => (
          <li class="hs-panel">
            <span class="hs-no">{String(i + 1).padStart(2, '0')} / {String(s.panels.length).padStart(2, '0')}</span>
            {image && <img class:list={['hs-img', { wide: !!image.w && !!image.h && image.w / image.h > 2.2 }]} src={image.src} alt={image.alt} width={image.w} height={image.h} loading="lazy" decoding="async" />}
            {p.portrait ? (
              <div class="hs-person">
                <img class="hs-face" src={p.portrait.src} alt={p.portrait.alt} width="400" height="400" loading="lazy" decoding="async" />
                <div>
                  {p.kicker && <span class="hs-kicker">{p.kicker}</span>}
                  <h3>{p.title}</h3>
                </div>
              </div>
            ) : (
              <>
                {p.kicker && <span class="hs-kicker">{p.kicker}</span>}
                <h3>{p.title}</h3>
              </>
            )}
            {p.figure && <p class="hs-fig"><b>{p.figure.value}</b><span>{p.figure.label}</span></p>}
            <p class="hs-text"><span set:html={rich(p.text)} /><SourceRef src={p.src} /></p>
            <Notes notes={p.notes} />
            {p.portrait && (
              <p class="hs-credit">
                照片：<a href={p.portrait.sourceUrl} target="_blank" rel="noopener noreferrer">{p.portrait.credit}</a>，
                <a href={p.portrait.licenseUrl} target="_blank" rel="noopener noreferrer">{p.portrait.license}</a>{p.portrait.cropped && '（經裁切）'}，取自 Wikimedia Commons
              </p>
            )}
            {!inline && <MoreRef m={p.more} />}
            {inline && (
              <details class="hs-more" data-expand open={!fold}>
                <summary class="hs-more-title">{p.more!.title}</summary>
                <div class="expand-body"><MoreBody m={p.more!} /></div>
              </details>
            )}
          </li>
        ))}
      </ol>
    </div>
    <div class="hs-foot wrap">
      <span class="hs-bar" aria-hidden="true"><span data-hs-progress></span></span>
      <span class="source">{s.source}</span>
    </div>
  </div>
</section>
<style>
  .hscroll { position: relative; height: calc(var(--panels) * 55svh + 60svh); }
  .hs-pin { position: sticky; top: 0; height: 100svh; display: grid; grid-template-rows: auto 1fr auto; padding: 72px 0 20px; overflow: hidden; }
  .hs-head { width: 100%; }
  .hs-intro { margin: 6px 0 0; max-width: 40rem; font-size: clamp(17px, 1vw + 12px, 20px); max-height: 14em; overflow: hidden; transition: max-height .45s ease, opacity .3s, margin .45s; }
  /* 卡片展開後太高（scrolly.ts 量測後加 hs-tight）：收起上方引言，把高度讓給卡片 */
  .hs-pin:global(.hs-tight) .hs-intro { max-height: 0; opacity: 0; margin: 0; }
  /* 同一組卡片等高（拉齊到最高那張）；整條軌道在可用高度內置中，比可用高度還高時從上緣對齊（safe），不會被上下裁掉 */
  .hs-viewport { overflow: hidden; display: flex; align-items: safe center; min-height: 0; padding: 10px 0; }
  .hs-track { list-style: none; margin: 0; padding: 0 var(--gutter); display: flex; align-items: stretch; gap: clamp(14px, 2vw, 24px); will-change: transform; }
  /* 寬螢幕也只露出約 2.3 格，讓橫向移動明顯 */
  /* 最後手段：仍然放不下時，卡片本身可上下捲動（細捲軸） */
  .hs-panel { flex: none; width: clamp(16rem, 42vw, 34rem); min-height: min(36svh, 16rem); max-height: var(--hs-room, 100%); overflow-y: auto; scrollbar-width: thin; overscroll-behavior: contain; display: grid; align-content: start; gap: 8px; padding: 22px 22px 18px; border-radius: 16px; background: var(--paper); border: 2px solid var(--ink); box-shadow: 6px 6px 0 var(--accent); }
  .hs-no { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); }
  .hs-img { width: 100%; height: min(24svh, 12rem); object-fit: cover; border-radius: 10px; border: 1px solid var(--line); background: var(--paper-2); }
  /* 橫幅型圖片（例如寬 4:1 的海報）若用 cover 會被裁成一小塊再放大而變糊，改為完整顯示 */
  .hs-img.wide { height: auto; max-height: min(24svh, 12rem); object-fit: contain; }
  .hs-kicker { font-size: 12px; font-weight: var(--fw-bold); color: var(--accent-ink); }
  /* 人物頭像：圓形，與職稱、姓名並排；授權小字放在主文下方 */
  .hs-person { display: flex; align-items: center; gap: 14px; }
  .hs-person > div { display: grid; gap: 4px; }
  .hs-face { flex: none; width: clamp(64px, 5vw + 32px, 88px); height: auto; aspect-ratio: 1; border-radius: 50%; object-fit: cover; border: 2px solid var(--ink); box-shadow: 3px 3px 0 var(--accent); background: var(--paper-2); }
  .hs-credit { margin: -2px 0 0; font-size: 11px; line-height: 1.5; color: var(--ink-3); }
  .hs-credit a { color: inherit; }
  .hs-panel h3 { margin: 0; font-size: clamp(20px, 1.4vw + 14px, 26px); line-height: 1.35; }
  .hs-fig { margin: 4px 0; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .hs-fig b { font-size: clamp(30px, 3vw + 16px, 44px); color: var(--accent-ink); line-height: 1.1; font-variant-numeric: tabular-nums; }
  .hs-fig span { font-size: 13px; color: var(--ink-2); }
  .hs-text { margin: 0; font-size: 15px; line-height: 1.75; }
  /* 卡片內的細節：淡底色區塊，與主文區隔；引文縮小成卡片尺寸 */
  .hs-more { margin-top: 4px; padding: 12px 14px; border-radius: 10px; background: var(--paper-2); }
  .hs-more-title { margin: 0 0 6px; font-size: 13px; font-weight: var(--fw-bold); color: var(--accent-ink); }
  .hs-more-title::before { content: "延伸｜"; color: var(--ink-3); font-weight: 500; }
  details.hs-more > summary { cursor: pointer; list-style: none; margin: 0; }
  details.hs-more > summary::-webkit-details-marker { display: none; }
  details.hs-more > summary::after { content: "　▾ 展開"; font-weight: 500; color: var(--ink-3); }
  details.hs-more > summary::after { transition: color .2s; }
  details.hs-more > summary:hover::after { color: var(--accent-ink); }
  details.hs-more[open] > summary { margin-bottom: 8px; }
  details.hs-more[open] > summary::after { content: "　▴ 收合"; }
  .hs-more :global(.quote) { font-size: 15px; line-height: 1.7; border-left-width: 3px; padding-left: 12px; }
  .hs-more :global(.quote-cite) { margin-top: 6px; font-size: 12px; }
  .hs-more :global(.more-text) { font-size: 14px; margin-bottom: 8px; }
  .hs-more :global(.more-links) { margin-top: 10px; }
  .hs-foot { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; width: 100%; }
  .hs-bar { flex: 0 0 8rem; height: 4px; border-radius: 2px; background: var(--paper-2); overflow: hidden; }
  .hs-bar span { display: block; height: 100%; background: var(--accent-ink); transform-origin: left; transform: scaleX(0); }

  /* 退回原生左右滑動：很矮的視窗、偏好減少動態 */
  @media (max-height: 560px), (prefers-reduced-motion: reduce) {
    .hscroll { height: auto; }
    .hs-pin { position: relative; height: auto; padding: 48px 0 24px; }
    .hs-viewport { overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; }
    .hs-panel { scroll-snap-align: start; }
    .hs-track { transform: none !important; }
    .hs-bar { display: none; }
  }
</style>
