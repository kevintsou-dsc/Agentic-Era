---
import type { Scene, Beat } from '../lib/story';
import { rich } from '../lib/rich';
import Quote from './Quote.astro';
import SourceRef from './SourceRef.astro';
import MoreRef from './MoreRef.astro';
import HScroll from './HScroll.astro';
import Graphic from './graphics/Graphic.astro';
interface Props { scenes: Scene[] }
const { scenes } = Astro.props;
---
{scenes.map((s, si) => {
  if (s.kind === 'graphic') {
    return (
      <section class:list={['scrolly', { 'graphic-right': (s.side ?? (si % 2 ? 'right' : 'left')) === 'right' }]}>
        <div class="graphic">
          <Graphic g={s.graphic} />
        </div>
        <div class="steps">
          {s.beats.map((b: Beat) => (
            <div class="step">
              <div class="card">
                {b.tag && <p class="beat-tag">{b.tag}</p>}
                <p class="beat"><span set:html={rich(b.text)} /><SourceRef src={b.src} /></p>
                {b.quote && <Quote q={b.quote} />}
                <MoreRef m={b.more} />
              </div>
            </div>
          ))}
        </div>
      </section>
    );
  }
  if (s.kind === 'hscroll') return <HScroll s={s} />;
  if (s.kind === 'prose') {
    return (
      <section class:list={['section prose', { 'with-img': !!s.image, flip: si % 2 === 1 }]}>
        <div class="prose-text">
          {s.eyebrow && <p class="eyebrow reveal">{s.eyebrow}</p>}
          {s.heading && <h2 class="prose-h reveal" set:html={rich(s.heading)} />}
          {s.beats.map((b) => (
            <div class:list={['reveal', { 'has-more': !!b.more }]}>
              <p class="beat"><span set:html={rich(b.text)} /><SourceRef src={b.src} /></p>
              {b.quote && <Quote q={b.quote} />}
              <MoreRef m={b.more} />
            </div>
          ))}
        </div>
        {s.image && (
          <figure class="prose-fig reveal">
            <img src={s.image.src} alt={s.image.alt} width={s.image.w} height={s.image.h} style={s.image.w ? `max-width:${s.image.w}px` : undefined} loading="lazy" decoding="async" />
            <figcaption>
              {s.image.caption}{s.image.credit && <span class="credit">　{s.image.credit}</span>}
              {s.links?.map((l) => <a class="lnk" href={l.url} target="_blank" rel="noopener noreferrer">{l.kind === 'video' ? '看影片' : '看原始連結'}：{l.label} ↗</a>)}
            </figcaption>
          </figure>
        )}
      </section>
    );
  }
  if (s.kind === 'quote') {
    return (
      <section class="section">
        {s.lead && <div class="reveal"><p class="lede"><span set:html={rich(s.lead.text)} /><SourceRef src={s.lead.src} /></p><MoreRef m={s.lead.more} /></div>}
        <div class="reveal"><Quote q={s.quote} size="lg" /></div>
      </section>
    );
  }
  if (s.kind === 'bignum') {
    return (
      <section class="section center bignum-scene">
        {/* 數字動畫只改 data-count 這個 span，單位放在外面才不會被覆蓋掉 */}
        <p class="bignum reveal">
          <span data-count={s.value} data-decimals={s.decimals ?? 0} data-prefix={s.prefix ?? ''}>{(s.prefix ?? '') + s.value.toFixed(s.decimals ?? 0)}</span><small>{s.unit}</small>
        </p>
        {s.people && (
          <div class="people reveal" role="img" aria-label={`${s.people.total} 人中有 ${s.people.filled} 人${s.people.label ? `：${s.people.label}` : ''}`}>
            <ol class:list={['people-grid', { dense: s.people.total > 20 }]} style={`--cols:${s.people.total <= 10 ? s.people.total : 10}`}>
              {Array.from({ length: s.people.total }, (_, i) => (
                <li class:list={['person', { on: i < s.people!.filled }]} style={`--i:${i}`}>
                  {s.people!.icon === 'elder' && i < s.people!.filled ? (
                    <svg viewBox="0 0 24 40" aria-hidden="true"><circle cx="14" cy="9" r="5" /><path d="M4 38 V28 Q3 17 11 16 Q17 15.5 18 21 L17 25 L13 26 V38 Z" /><path class="cane" d="M16 22 L20.5 25.5" /><path class="cane" d="M21 39 V26 Q21 23 18.5 23" /></svg>
                  ) : (
                    <svg viewBox="0 0 24 40" aria-hidden="true"><circle cx="12" cy="7" r="6" /><path d="M3 38 V22 q0 -8 9 -8 q9 0 9 8 V38 z" /></svg>
                  )}
                </li>
              ))}
            </ol>
            {s.people.label && <p class="people-label"><b>{s.people.filled}</b>{` ／ ${s.people.total} ${s.people.label}`}</p>}
          </div>
        )}
        <p class="lede reveal"><span set:html={rich(s.caption.text)} /><SourceRef src={s.caption.src} /></p>
        <p class="source reveal">{s.source}</p>
      </section>
    );
  }
  return (
    <section class="section center">
      {s.eyebrow && <p class="eyebrow reveal">{s.eyebrow}</p>}
      <h2 class="display reveal statement" set:html={rich(s.text)} />
      {s.lede && <p class="lede reveal"><span set:html={rich(s.lede.text)} /><SourceRef src={s.lede.src} /></p>}
    </section>
  );
})}
<style>
  .statement { font-size: clamp(28px, 4.5vw, 52px); }
  .bignum-scene .bignum { color: var(--accent-ink); }
  /* 人形圖：例如 20 人中 13 人實心＝65%；進入視窗時依序填滿 */
  .people { display: grid; justify-items: center; gap: 10px; margin: 8px auto 20px; }
  .people-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols), clamp(22px, 3.4vw, 38px)); gap: clamp(6px, 1vw, 12px) clamp(4px, .8vw, 10px); }
  /* 100 人（例如 89%）：每列 10 人，縮小圖示，填色間隔縮短 */
  .people-grid.dense { grid-template-columns: repeat(10, clamp(14px, 2vw, 22px)); gap: 4px 6px; }
  .people-grid.dense .person circle, .people-grid.dense .person path { transition-delay: calc(var(--i) * 14ms + .3s); }
  .person svg { display: block; width: 100%; height: auto; overflow: visible; }
  .person circle, .person path { fill: transparent; stroke: var(--ink-3); stroke-width: 2; transition: fill .35s, stroke .35s; transition-delay: calc(var(--i) * 70ms + .3s); }
  .people.is-in .person.on circle, .people.is-in .person.on path { fill: var(--accent-ink); stroke: var(--accent-ink); }
  .person .cane { fill: none !important; stroke-linecap: round; stroke-width: 2.4; }
  .people-label { margin: 0; font-size: 14px; color: var(--ink-2); }
  .people-label b { font-size: 18px; color: var(--accent-ink); }
  @media (prefers-reduced-motion: reduce) {
    .person.on circle, .person.on path { fill: var(--accent-ink); stroke: var(--accent-ink); }
  }
  .beat { margin: 0 0 .6em; }
  .beat-tag { display: inline-block; margin: 0 0 8px !important; padding: 2px 10px; border-radius: 999px; background: var(--ink); color: var(--paper); font-size: 12px; font-weight: 800; letter-spacing: .12em; }
  .graphic { flex-direction: column; }

  .prose { display: grid; gap: clamp(24px, 4vw, 56px); align-items: center; padding-top: 12svh; padding-bottom: 12svh; }
  .prose-text { max-width: 40rem; font-size: clamp(17px, .6vw + 14px, 19px); }
  .prose-h { font-size: clamp(24px, 2.4vw + 12px, 36px); line-height: 1.35; margin: 4px 0 18px; }
  .prose-text .beat { margin-bottom: 1em; }
  /* 細節按鈕緊貼它補充的那段，與下一段拉開距離，看得出屬於上一段 */
  .prose-text .has-more .beat { margin-bottom: 0; }
  .prose-text .has-more > :global(.more-ref) { margin: 6px 0 1.6em; }
  @media (min-width: 900px) {
    .prose.with-img { grid-template-columns: 1.1fr .9fr; }
    .prose.with-img.flip .prose-text { order: 2; }
  }
  .prose-fig { margin: 0; }
  .prose-fig img { width: 100%; height: auto; max-height: 70svh; object-fit: contain; border-radius: 12px; border: 2px solid var(--ink); box-shadow: 8px 8px 0 var(--accent); background: var(--paper-2); }
  .prose-fig figcaption { margin-top: 10px; font-size: 13px; color: var(--ink-2); line-height: 1.6; }
  .credit { color: var(--ink-3); }
  .lnk { display: inline-block; margin-top: 4px; font-weight: 700; color: var(--accent-ink); }
</style>
