---
import type { Scene, Beat } from '../lib/story';
import { rich } from '../lib/rich';
import Quote from './Quote.astro';
import SourceRef from './SourceRef.astro';
import MoreRef from './MoreRef.astro';
import HScroll from './HScroll.astro';
import Graphic from './graphics/Graphic.astro';
interface Props { scenes: Scene[] }
const { scenes } = Astro.props;
---
{scenes.map((s, si) => {
  if (s.kind === 'graphic') {
    return (
      <section class:list={['scrolly', { 'graphic-right': (s.side ?? (si % 2 ? 'right' : 'left')) === 'right' }]}>
        <div class="graphic">
          <Graphic g={s.graphic} />
          {s.src && <p class="graphic-src">這張圖出自<SourceRef src={s.src} /></p>}
        </div>
        <div class="steps">
          {s.beats.map((b: Beat) => (
            <div class="step">
              <div class="card">
                <p class="beat"><span set:html={rich(b.text)} /><SourceRef src={b.src} /></p>
                {b.quote && <Quote q={b.quote} />}
                <MoreRef m={b.more} />
              </div>
            </div>
          ))}
        </div>
      </section>
    );
  }
  if (s.kind === 'hscroll') return <HScroll s={s} />;
  if (s.kind === 'prose') {
    return (
      <section class:list={['section prose', { 'with-img': !!s.image, flip: si % 2 === 1 }]}>
        <div class="prose-text">
          {s.eyebrow && <p class="eyebrow reveal">{s.eyebrow}</p>}
          {s.heading && <h2 class="prose-h reveal" set:html={rich(s.heading)} />}
          {s.beats.map((b) => (
            <div class="reveal">
              <p class="beat"><span set:html={rich(b.text)} /><SourceRef src={b.src} /></p>
              {b.quote && <Quote q={b.quote} />}
              <MoreRef m={b.more} />
            </div>
          ))}
        </div>
        {s.image && (
          <figure class="prose-fig reveal">
            <img src={s.image.src} alt={s.image.alt} width={s.image.w} height={s.image.h} loading="lazy" decoding="async" />
            <figcaption>
              {s.image.caption}{s.image.credit && <span class="credit">　{s.image.credit}</span>}
              {s.links?.map((l) => <a class="lnk" href={l.url} target="_blank" rel="noopener noreferrer">{l.kind === 'video' ? '看影片' : '看原始連結'}：{l.label} ↗</a>)}
            </figcaption>
          </figure>
        )}
      </section>
    );
  }
  if (s.kind === 'quote') {
    return (
      <section class="section">
        {s.lead && <div class="reveal"><p class="lede"><span set:html={rich(s.lead.text)} /><SourceRef src={s.lead.src} /></p><MoreRef m={s.lead.more} /></div>}
        <div class="reveal"><Quote q={s.quote} size="lg" /></div>
      </section>
    );
  }
  if (s.kind === 'bignum') {
    return (
      <section class="section center bignum-scene">
        <p class="bignum reveal" data-count={s.value} data-decimals={s.decimals ?? 0} data-prefix={s.prefix ?? ''}>
          {(s.prefix ?? '') + s.value.toFixed(s.decimals ?? 0)}<small>{s.unit}</small>
        </p>
        <p class="lede reveal"><span set:html={rich(s.caption.text)} /><SourceRef src={s.caption.src} /></p>
        <p class="source reveal">{s.source}</p>
      </section>
    );
  }
  return (
    <section class="section center">
      {s.eyebrow && <p class="eyebrow reveal">{s.eyebrow}</p>}
      <h2 class="display reveal statement" set:html={rich(s.text)} />
      {s.lede && <p class="lede reveal"><span set:html={rich(s.lede.text)} /><SourceRef src={s.lede.src} /></p>}
    </section>
  );
})}
<style>
  .statement { font-size: clamp(28px, 4.5vw, 52px); }
  .bignum-scene .bignum { color: var(--accent-ink); }
  .beat { margin: 0 0 .6em; }
  .graphic { flex-direction: column; }
  .graphic-src { margin: 8px 0 0; font-size: 12px; color: var(--ink-3); }

  .prose { display: grid; gap: clamp(24px, 4vw, 56px); align-items: center; padding-top: 12svh; padding-bottom: 12svh; }
  .prose-text { max-width: 40rem; font-size: clamp(17px, .6vw + 14px, 19px); }
  .prose-h { font-size: clamp(24px, 2.4vw + 12px, 36px); line-height: 1.35; margin: 4px 0 18px; }
  .prose-text .beat { margin-bottom: 1em; }
  @media (min-width: 900px) {
    .prose.with-img { grid-template-columns: 1.1fr .9fr; }
    .prose.with-img.flip .prose-text { order: 2; }
  }
  .prose-fig { margin: 0; }
  .prose-fig img { width: 100%; height: auto; max-height: 70svh; object-fit: contain; border-radius: 12px; border: 2px solid var(--ink); box-shadow: 8px 8px 0 var(--accent); background: var(--paper-2); }
  .prose-fig figcaption { margin-top: 10px; font-size: 13px; color: var(--ink-2); line-height: 1.6; }
  .credit { color: var(--ink-3); }
  .lnk { display: inline-block; margin-top: 4px; font-weight: 700; color: var(--accent-ink); }
</style>
