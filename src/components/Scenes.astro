---
import type { Scene, Beat } from '../lib/story';
import { rich } from '../lib/rich';
import Quote from './Quote.astro';
import SourceRef from './SourceRef.astro';
import MoreRef from './MoreRef.astro';
import Notes from './Notes.astro';
import HScroll from './HScroll.astro';
import Graphic from './graphics/Graphic.astro';
interface Props { scenes: Scene[]; chapter?: 'intro' | 'people' | 'model' | 'ai'; seed?: number }
const { scenes, chapter = 'people', seed = 0 } = Astro.props;
// 留白插圖（封面扉頁素材）：純文字段落的右側大片空白放一張淡淡的插圖，依章節換主圖，與向日葵素描輪流
const SIDE: Record<string, string> = { intro: 'sunflower', people: 'heart', model: 'ai-face', ai: 'ascii-back' };
const sideArt = (k: number) => `/art/cover/${k % 2 ? 'sunflower' : SIDE[chapter]}.webp`;
// 文中小插圖（刊物配圖的手繪線稿）：放在引言段落上方，線條用墨色、色塊用章節色
const SPOTS = [
  ['search', 383, 239], ['growth', 326, 239], ['box', 292, 256], ['pie', 433, 342],
  ['browser', 457, 289], ['board', 293, 303], ['stack', 355, 311], ['doc', 351, 333],
] as const;
const spot = (k: number) => SPOTS[(seed * 3 + k) % SPOTS.length];
let proseK = 0, quoteK = 0;
---
{scenes.map((s, si) => {
  if (s.kind === 'graphic') {
    return (
      <section class:list={['scrolly', { 'graphic-right': (s.side ?? (si % 2 ? 'right' : 'left')) === 'right' }]}>
        <div class="graphic">
          <Graphic g={s.graphic} />
        </div>
        <div class="steps">
          {s.beats.map((b: Beat) => (
            <div class="step">
              <div class="card">
                <button type="button" class="peek" data-peek aria-pressed="false" aria-label="淡化文字，看清楚圖表"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path class="eye" d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" /><circle class="eye" cx="12" cy="12" r="3" /><path class="slash" d="M4 4l16 16" /></svg></button>
                {b.tag && <p class="beat-tag">{b.tag}</p>}
                <p class="beat"><span set:html={rich(b.text)} /><SourceRef src={b.src} /></p>
                {b.quote && <Quote q={b.quote} />}
                <MoreRef m={b.more} />
                <Notes notes={b.notes} />
              </div>
            </div>
          ))}
        </div>
      </section>
    );
  }
  if (s.kind === 'hscroll') return <HScroll s={s} />;
  if (s.kind === 'prose') {
    const side = !s.image ? sideArt(proseK++) : null;
    return (
      <section class:list={['section prose', { 'with-img': !!s.image, flip: si % 2 === 1, 'has-side': !!side }]}>
        {side && <div class="side-art" aria-hidden="true"><img src={side} alt="" loading="lazy" decoding="async" /></div>}
        <div class="prose-text">
          {s.eyebrow && <p class="eyebrow reveal">{s.eyebrow}</p>}
          {s.heading && <h2 class="prose-h reveal" set:html={rich(s.heading)} />}
          {s.beats.map((b) => (
            <div class:list={['reveal', { 'has-more': !!b.more || !!b.notes?.length }]}>
              <p class="beat"><span set:html={rich(b.text)} /><SourceRef src={b.src} /></p>
              {b.quote && <Quote q={b.quote} />}
              <MoreRef m={b.more} />
              <Notes notes={b.notes} />
            </div>
          ))}
        </div>
        {s.image && (
          <figure class="prose-fig reveal">
            <img src={s.image.src} alt={s.image.alt} width={s.image.w} height={s.image.h} style={s.image.w ? `max-width:${s.image.w}px` : undefined} loading="lazy" decoding="async" />
            <figcaption>
              {s.image.caption}{s.image.credit && <span class="credit">{s.image.credit}</span>}
              {s.links?.map((l) => <a class="lnk" href={l.url} target="_blank" rel="noopener noreferrer">{l.kind === 'video' ? '看影片' : '看原始連結'}：{l.label} ↗</a>)}
            </figcaption>
          </figure>
        )}
      </section>
    );
  }
  if (s.kind === 'quote') {
    const [sp, sw, sh] = spot(quoteK++);
    // 每篇最後一幕（22 篇都是引言）是結語：加重處理（docs/design-review/p1-02-ruling.md D2、L10）
    return (
      <section class:list={['section', { finale: si === scenes.length - 1 }]}>
        <div class="spot reveal" aria-hidden="true" style={`--ar:${sw}/${sh};--fill:url(/art/spots/${sp}-fill.webp);--line:url(/art/spots/${sp}-line.webp)`}><span class="spot-fill"></span><span class="spot-line"></span></div>
        {s.lead && <div class:list={['reveal q-lead', { 'has-more': !!s.lead.more }]}><p class="lede"><span set:html={rich(s.lead.text)} /><SourceRef src={s.lead.src} /></p><MoreRef m={s.lead.more} /><Notes notes={s.lead.notes} /></div>}
        <div class="reveal"><Quote q={s.quote} size="lg" /></div>
      </section>
    );
  }
  if (s.kind === 'bignum') {
    return (
      <section class="section center bignum-scene">
        {/* 數字動畫只改 data-count 這個 span，單位放在外面才不會被覆蓋掉 */}
        <p class="bignum reveal">
          <span data-count={s.value} data-decimals={s.decimals ?? 0} data-prefix={s.prefix ?? ''}>{(s.prefix ?? '') + s.value.toFixed(s.decimals ?? 0)}</span><small>{s.unit}</small>
        </p>
        {s.people && (
          <div class="people reveal" role="img" aria-label={`${s.people.total} 人中有 ${s.people.filled} 人${s.people.label ? `：${s.people.label}` : ''}`}>
            <ol class:list={['people-grid', { dense: s.people.total > 20 }]} style={`--cols:${s.people.total <= 10 ? s.people.total : 10}`}>
              {Array.from({ length: s.people.total }, (_, i) => (
                <li class:list={['person', { on: i < s.people!.filled }]} style={`--i:${i}`}>
                  {s.people!.icon === 'elder' && i < s.people!.filled ? (
                    <svg viewBox="0 0 24 40" aria-hidden="true"><circle cx="14" cy="9" r="5" /><path d="M4 38 V28 Q3 17 11 16 Q17 15.5 18 21 L17 25 L13 26 V38 Z" /><path class="cane" d="M16 22 L20.5 25.5" /><path class="cane" d="M21 39 V26 Q21 23 18.5 23" /></svg>
                  ) : (
                    <svg viewBox="0 0 24 40" aria-hidden="true"><circle cx="12" cy="7" r="6" /><path d="M3 38 V22 q0 -8 9 -8 q9 0 9 8 V38 z" /></svg>
                  )}
                </li>
              ))}
            </ol>
            {s.people.label && <p class="people-label"><b>{s.people.filled}</b>{` ／ ${s.people.total} ${s.people.label}`}</p>}
          </div>
        )}
        <p class="lede reveal"><span set:html={rich(s.caption.text)} /><SourceRef src={s.caption.src} /></p>
        {!!s.caption.notes?.length && <p class="reveal note-row"><Notes notes={s.caption.notes} /></p>}
        <p class="source reveal">{s.source}</p>
      </section>
    );
  }
  // 陳述幕：外層章節色帶（半透明，紙紋透得出來），作為每篇的換氣點
  return (
    <div class="band">
      <section class="section center">
        {s.eyebrow && <p class="eyebrow reveal">{s.eyebrow}</p>}
        <h2 class="display reveal statement" set:html={rich(s.text)} />
        {s.lede && <p class="lede reveal"><span set:html={rich(s.lede.text)} /><SourceRef src={s.lede.src} /><Notes notes={s.lede.notes} /></p>}
      </section>
    </div>
  );
})}
<style>
  .statement { font-size: clamp(28px, 4.5vw, 52px); font-family: var(--font-serif); font-weight: 900; }
  /* 陳述幕色帶：章節色 55%（序章的章節色接近紙色，改用牛皮紙色 45%）；色帶裡的字一律墨色（章節深色字在章節色底上對比不足） */
  .band { background: color-mix(in srgb, var(--accent) 55%, transparent); }
  :global(.ch-intro) .band { background: color-mix(in srgb, var(--kraft) 45%, transparent); }
  .band > .section { padding-block: 14svh; }
  .band .eyebrow, .band .lede, .band :global(.src-ref) { color: var(--ink); }
  .band :global(.src-ref) { border-color: var(--ink); }
  /* 結語引言：上方一道章節色短線、字級再大一級；維持靠左與左線（不置中，引言前的說明段落也不會跟著置中）。
     線畫在段落內距之內，不貼著上一幕的邊緣（陳述色帶緊接結語時才不會像色帶的底線） */
  .finale::before { content: ""; display: block; width: min(100%, 40rem); height: 2px; margin-bottom: clamp(28px, 5svh, 48px); background: var(--accent-ink); }
  .finale :global(.quote-block.lg .quote) { font-size: clamp(26px, 3vw + 12px, 46px); }
  /* p 預設 margin 以字級計算，大數字下方會空出一大段；改為固定的小間距，讓數字和人形圖連成一組 */
  .bignum-scene .bignum { color: var(--accent-ink); margin: 0 0 clamp(14px, 2.5svh, 28px); }
  /* 人形圖：例如 20 人中 13 人實心＝65%；進入視窗時依序填滿 */
  .people { display: grid; justify-items: center; gap: 10px; margin: 8px auto 20px; }
  .people-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols), clamp(22px, 3.4vw, 38px)); gap: clamp(6px, 1vw, 12px) clamp(4px, .8vw, 10px); }
  /* 100 人（例如 89%）：每列 10 人，縮小圖示，填色間隔縮短 */
  .people-grid.dense { grid-template-columns: repeat(10, clamp(14px, 2vw, 22px)); gap: 4px 6px; }
  /* 桌機寬度夠：100 人排成 20×5，比 10×10 矮一半 */
  @media (min-width: 720px) { .people-grid.dense { grid-template-columns: repeat(20, clamp(14px, 1.6vw, 22px)); } }
  .people-grid.dense .person circle, .people-grid.dense .person path { transition-delay: calc(var(--i) * 14ms + .3s); }
  .person svg { display: block; width: 100%; height: auto; overflow: visible; }
  .person circle, .person path { fill: transparent; stroke: var(--ink-3); stroke-width: 2; transition: fill .35s, stroke .35s; transition-delay: calc(var(--i) * 70ms + .3s); }
  .people.is-in .person.on circle, .people.is-in .person.on path { fill: var(--accent-ink); stroke: var(--accent-ink); }
  .person .cane { fill: none !important; stroke-linecap: round; stroke-width: 2.4; }
  .people-label { margin: 0; font-size: 14px; color: var(--ink-2); }
  .people-label b { font-size: 18px; color: var(--accent-ink); }
  @media (prefers-reduced-motion: reduce) {
    .person.on circle, .person.on path { fill: var(--accent-ink); stroke: var(--accent-ink); }
  }
  .beat { margin: 0 0 .6em; }
  .beat-tag { display: inline-block; margin: 0 0 8px !important; padding: 2px 10px; border-radius: 999px; background: var(--ink); color: var(--paper); font-size: 12px; font-weight: var(--fw-bold); letter-spacing: .12em; }
  .graphic { flex-direction: column; }

  /* 留白插圖：只在寬螢幕、文字欄右側有大片空白時出現；淡淡一層，隨捲動輕微視差 */
  .has-side { position: relative; }
  .side-art { display: none; }
  @media (min-width: 1100px) {
    .side-art { display: block; position: absolute; right: var(--gutter); top: 50%; width: min(26vw, 400px); translate: 0 -50%; pointer-events: none; z-index: -1; }
    .side-art img { width: 100%; height: auto; opacity: .2; mix-blend-mode: multiply; filter: grayscale(1) contrast(1.1); }
    @supports (animation-timeline: view()) {
      .side-art img { animation: side-drift linear both; animation-timeline: view(); }
    }
  }
  @keyframes side-drift { from { transform: translateY(60px) rotate(-1.5deg); } to { transform: translateY(-60px) rotate(1.5deg); } }
  /* 文中小插圖：兩層遮罩，線條墨色、色塊章節色 */
  .spot { position: relative; width: clamp(84px, 9vw, 124px); aspect-ratio: var(--ar); margin: 0 0 14px; }
  .spot span { position: absolute; inset: 0; -webkit-mask: var(--m) center / contain no-repeat; mask: var(--m) center / contain no-repeat; }
  .spot-fill { --m: var(--fill); background: var(--accent); }
  .spot-line { --m: var(--line); background: var(--ink); }
  .spot.reveal { transform: translateY(16px) rotate(-4deg); }
  .spot.reveal.is-in { transform: none; transition-timing-function: cubic-bezier(.3, 1.5, .5, 1); }
  @media (prefers-reduced-motion: reduce) { .side-art img { animation: none; } }
  /* 引言段：延伸按鈕緊貼它補充的那段文字，和下方大引言之間留出明顯距離，讀者才知道它在補充上面那句 */
  .q-lead.has-more .lede { margin-bottom: 4px; }
  .q-lead.has-more > :global(.more-ref) { margin-top: 2px; }
  .q-lead { margin-bottom: clamp(36px, 6svh, 64px); }
  .prose { display: grid; gap: clamp(24px, 4vw, 56px); align-items: center; padding-top: 12svh; padding-bottom: 12svh; }
  .prose-text { max-width: 40rem; font-size: clamp(17px, .6vw + 14px, 19px); }
  .prose-h { font-size: clamp(24px, 2.4vw + 12px, 36px); line-height: 1.35; margin: 4px 0 18px; font-family: var(--font-serif); font-weight: 900; }
  .prose-text .beat { margin-bottom: 1em; }
  /* 細節按鈕緊貼它補充的那段，與下一段拉開距離，看得出屬於上一段 */
  .prose-text .has-more .beat { margin-bottom: 0; }
  .prose-text .has-more > :global(.more-ref) { margin: 6px 0 1.6em; }
  @media (min-width: 900px) {
    .prose.with-img { grid-template-columns: 1.1fr .9fr; }
    .prose.with-img.flip .prose-text { order: 2; }
  }
  .prose-fig { margin: 0; }
  .prose-fig img { width: 100%; height: auto; max-height: 70svh; object-fit: contain; border-radius: 12px; border: 2px solid var(--ink); box-shadow: 8px 8px 0 var(--accent); background: var(--paper-2); }
  .prose-fig figcaption { margin-top: 10px; font-size: 13px; color: var(--ink-2); line-height: 1.6; }
  .credit { color: var(--ink-3); }
  .lnk { display: inline-block; margin-top: 4px; font-weight: var(--fw-bold); color: var(--accent-ink); }
</style>
