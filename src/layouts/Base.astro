---
import '@fontsource-variable/noto-sans-tc';
import '../styles/global.css';
import DentsuLogo from '../components/DentsuLogo.astro';
import Loader from '../components/home/Loader.astro';

interface Props {
  title: string;
  description: string;
  chapter?: 'intro' | 'people' | 'model' | 'ai';
  crumb?: string;
  /** 分享預覽圖（public/og/，由 npm run og 產生）；沒給就用首頁那張 */
  og?: string;
  ogType?: 'website' | 'article';
}
const { title, description, chapter = 'people', crumb, og = '/og/home.png', ogType = 'article' } = Astro.props;
// og:image 多數平台要絕對網址：astro.config 設了 site（正式網域）就用絕對網址，否則先用站內路徑
const ogImage = Astro.site ? new URL(og, Astro.site).href : og;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const repo = 'https://github.com/kevintsou-dsc/Agentic-Era';
import SnackPack from '../components/SnackPack.astro';
---
<!doctype html>
<Fragment set:html={`<!--
  ┌──────────────────────────────────────────────────────────┐
     決策智慧 2026｜你打開了原始碼，這裡有三封小紙條。
  └──────────────────────────────────────────────────────────┘

  給評審：
    各位評審辛苦了！一口氣看完這麼多作品，眼睛和耐心都很珍貴。
    這個網站想做的事很簡單：讓一本 22 篇的厚書，被更多人真的讀完。
    每一句主文都對得回紙本頁碼，每張圖都先看過原圖才重畫。
    希望它讓您讀得順、看得開心。謝謝您的時間。

  給原文作者群：
    謝謝 22 篇觀點的每一位作者。內容真的很精彩——
    把這些文章拆成一格一格的捲動故事時，我們反覆讀了很多遍，
    每讀一次都有新的收穫。希望這個版本有替你們的文字加分。

  給每一位讀者：
    喜歡的話，歡迎多多交流！
    找到 bug、有想法、或只是想聊聊哪一篇最打動你，都很歡迎。
    （小提示：在頁面上直接用鍵盤打 dentsu 試試看。）

                                    —— Kevin Tsou | DSC
-->`} />
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="決策智慧 2026" />
    <meta property="og:locale" content="zh_TW" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f3eee4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- iOS「加入主畫面」與部分通訊軟體的預覽不吃 SVG 圖示，另給一張 180px PNG（與 favicon.svg 同圖） -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- 襯線顯示字：標題在首屏，先預載 900 那一檔（約 110 KB） -->
    <link rel="preload" href="/fonts/serif-900.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="author" href="/humans.txt" />
  </head>
  <body class={`ch-${chapter}`}>
    <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
      <!-- 手繪線條：低頻位移讓線條微微彎曲、高頻位移讓邊緣粗細不一，像原刊插圖的手繪筆觸 -->
      <filter id="hand" filterUnits="userSpaceOnUse" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="4" result="wobble" />
        <feDisplacementMap in="SourceGraphic" in2="wobble" scale="2.6" xChannelSelector="R" yChannelSelector="G" result="bent" />
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="1" seed="9" result="grain" />
        <feDisplacementMap in="bent" in2="grain" scale="1.3" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <Loader />
    <div class="curtain" aria-hidden="true"><i class="sheet sheet-a"></i><i class="sheet sheet-p"></i></div>
    <a class="skip" href="#main">跳到主要內容</a>
    <div class="progress" aria-hidden="true"><span data-progress></span></div>
    <header class="topbar">
      <a href="/" class="brand" aria-label="決策智慧 2026 首頁（dentsu）"><DentsuLogo class="brand-logo" /><span class="brand-sep" aria-hidden="true"></span><span class="mono">決策智慧 2026</span></a>
      <span class="top-r">
        {crumb && (() => { const [t, ...rest] = crumb.split('．'); return <span class="crumb">{t}{rest.length > 0 && <span class="crumb-x">．{rest.join('．')}</span>}</span>; })()}
        <nav class="top-nav" aria-label="全站導覽">
          <a href="/#chapters">目錄</a>
          <a href="/about/">關於</a>
        </nav>
        <button type="button" class="top-progress" data-snack-album="top" aria-label="成就卡收藏" title="成就卡收藏" hidden><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="7" y="3.5" width="12" height="16" rx="2" transform="rotate(8 13 11.5)"/><rect x="4.5" y="5" width="12" height="16" rx="2" fill="var(--paper)"/><path d="M10.5 9.6l1.1 2.2 2.4.35-1.75 1.7.4 2.4-2.15-1.13-2.15 1.13.4-2.4L7 12.15l2.4-.35z" fill="currentColor" stroke="none"/></svg></button>
      </span>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <p class="foot-brand"><a href="https://www.dentsu.com/tw/zh" target="_blank" rel="noopener noreferrer" aria-label="dentsu 台灣官網"><DentsuLogo class="foot-logo" /></a><span>電通行銷傳播集團｜決策智慧 2026</span></p>
        <p>內容出自 電通行銷傳播集團《決策智慧 2026：Agentic 時代，重塑品牌與人的真實距離》。所載編輯內容之著作權為原刊所有。</p>
        <p><a href="/#chapters">依章節找文章</a>　<a href="/about/">關於本作品</a>　<a href={repo} target="_blank" rel="noopener noreferrer">原始碼</a></p>
      </div>
    </footer>
    <SnackPack />
    <dialog id="reader" class="reader" aria-label="原文">
      <div class="reader-sheet">
        <header class="reader-head">
          <div>
            <p class="eyebrow">原文｜引用的段落已標示</p>
            <p class="reader-title" data-reader-title></p>
            <div class="reader-meta-slot" data-reader-meta></div>
          </div>
          <div class="reader-actions">
            <a class="reader-full" data-reader-full href="/">在新頁閱讀</a>
            <button type="button" class="dlg-close" data-reader-close aria-label="關閉原文">×</button>
          </div>
        </header>
        <div class="reader-body" data-reader-body tabindex="0"></div>
      </div>
    </dialog>
    <dialog id="more" class="more" aria-label="細節">
      <div class="more-sheet">
        <button type="button" class="dlg-close" data-more-close aria-label="關閉">×</button>
        <div data-more-body></div>
      </div>
    </dialog>
    <dialog id="zoom" class="zoom" aria-label="放大圖表">
      <div class="zoom-head"><span>左右滑動、雙指縮放查看全圖</span><button type="button" class="dlg-close" data-zoom-close aria-label="關閉">×</button></div>
      <div class="zoom-body" data-zoom-body tabindex="0"></div>
    </dialog>
    <script>
      import { initScrolly } from '../scripts/scrolly';
      import { initReader } from '../scripts/reader';
      import { initMore } from '../scripts/more';
      import { initExpand } from '../scripts/expand';
      import { initZoom } from '../scripts/zoom';
      import { initPaper } from '../scripts/paper';
      import { initEgg } from '../scripts/egg';
      import { initReadMap } from '../scripts/readmap';
      import { initPageExit } from '../scripts/pagexit';
      import { initShare } from '../scripts/share';
      import { initSnack } from '../scripts/snack';
      initScrolly();
      initReader();
      initMore();
      initExpand();
      initZoom();
      initPaper();
      initEgg();
      initReadMap();
      initPageExit();
      initShare();
      initSnack();
    </script>
  </body>
</html>
<style>
  .skip { position: absolute; left: -999px; top: 8px; z-index: 60; background: var(--ink); color: var(--paper); padding: 8px 14px; border-radius: var(--r-s); }
  .skip:focus { left: 8px; }
  .top-r { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .top-nav { flex: none; display: inline-flex; align-items: center; gap: 12px; font-size: var(--fs-meta); color: var(--ink-2); }
  .top-nav a { padding: 4px 2px; transition: color .2s; white-space: nowrap; }
  .top-nav a:hover { color: var(--ink); }
  .top-progress { position: relative; flex: none; display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border-radius: 50%; border: 1px solid var(--ink); background: var(--paper); color: var(--ink); cursor: pointer; }
  .top-progress[hidden] { display: none; }
  .top-progress:hover { background: var(--accent); }
  .top-progress:global(.has-pack)::after { content: ""; position: absolute; top: -2px; right: -2px; width: 9px; height: 9px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 0 2px var(--paper); animation: pack-dot 1.8s ease-in-out infinite; }
  @keyframes pack-dot { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.28); } }
  .crumb { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 46vw; }
  .brand { flex: none; display: inline-flex; align-items: center; gap: 10px; min-height: 32px; color: var(--ink); white-space: nowrap; }
  /* 手機的文章頁：頂欄放不下刊名與文章名稱，只留標誌，把寬度讓給文章名稱與精簡導覽 */
  @media (max-width: 560px) {
    .topbar:has(.crumb) .brand :is(.mono, .brand-sep) { display: none; }
    .crumb { max-width: 38vw; }
    .crumb-x { display: none; } /* 手機頂列只留篇名，分鐘數頁首已有 */
    .top-nav { gap: 8px; font-size: var(--fs-caption); }
  }
  .brand :global(.brand-logo) { width: 64px; height: auto; color: var(--ink); }
  .brand-sep { width: 1px; height: 14px; background: var(--ink-3); }
  .brand .mono { color: var(--ink-2); }
  .foot-brand { display: flex; align-items: center; gap: 14px; margin-bottom: 18px !important; font-weight: var(--fw-bold); color: var(--ink); }
  .foot-brand :global(.foot-logo) { width: 104px; height: auto; color: var(--ink); }
  .foot-brand a { margin: 0; }
  .footer { border-top: 1px solid var(--line); padding: 32px 0 48px; font-size: var(--fs-meta); color: var(--ink-2); }
  .footer p { margin: 0 0 8px; max-width: 46rem; }
  .footer a { margin-right: 4px; }
</style>
