---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import FaceMap from '../components/home/FaceMap.astro';
import ReadProgress from '../components/home/ReadProgress.astro';
import { totalMinutes, totalAuthors } from '../lib/articles';
import { CORE_QUESTION } from '../data/home';
const hours = Math.floor(totalMinutes / 60);
const mins = totalMinutes % 60;
---
<Base title="決策智慧 2026｜一個故事讀完整本" description="電通《決策智慧 2026》22 篇觀點的捲動閱讀版：1 分鐘看懂全書，幾分鐘讀完一篇精華，想深讀再看原文。" chapter="intro" ogType="website">
  <Hero quote={CORE_QUESTION} hours={hours} mins={mins} authors={totalAuthors} />

  <FaceMap />
  <ReadProgress />
  <script>
    import { initHero } from '../scripts/hero';
    initHero();
  </script>
</Base>
