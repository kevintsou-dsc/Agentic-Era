---
import Base from '../layouts/Base.astro';
import Quote from '../components/Quote.astro';
import BookDots from '../components/graphics/BookDots.astro';
import { ARTICLES, CHAPTERS, CHAPTER_ORDER, THREADS, totalMinutes, totalAuthors } from '../lib/articles';
import { STORIES } from '../data/stories';
import { CORE_QUESTION, THREAD_LINES } from '../data/home';
import { rich } from '../lib/rich';
const hours = Math.floor(totalMinutes / 60);
const mins = totalMinutes % 60;
const firstOf = (key: string) => ARTICLES.find((a) => a.threads.includes(key as never) && STORIES[a.id]);
---
<Base title="決策智慧 2026｜一個故事讀完整本" description="電通《決策智慧 2026》22 篇觀點的捲動閱讀版：1 分鐘看懂全書，90 秒讀完一篇，想深讀再看原文。" chapter="intro">
  <section class="hero">
    <p class="eyebrow">電通行銷傳播集團《決策智慧 2026》｜Agentic 時代：重塑品牌與人的真實距離</p>
    <h1 class="display">品牌離 AI 越近，<br />會離人越遠嗎？</h1>
    <p class="lede">22 篇觀點、{totalAuthors} 位作者，原文讀完約 <b>{hours} 小時 {mins} 分</b>。這裡用 1 分鐘帶你看懂整本，每篇再用 90 秒讀完。</p>
    <p class="actions">
      <span class="scroll-hint">往下捲動，故事會自己出現</span>
      <a class="skiplink" href="#chapters">或直接依章節找文章 ↓</a>
    </p>
  </section>

  <section class="section">
    <p class="curated reveal">本期的核心命題｜總編輯 邵懿文</p>
    <div class="reveal"><Quote q={CORE_QUESTION} size="lg" /></div>
  </section>

  <section class="scrolly">
    <div class="graphic"><BookDots /></div>
    <div class="steps">
      <div class="step"><div class="card"><p class="curated">整理：策展者</p><p>全書分四章：序章定調，<b>People</b> 談人，<b>Model</b> 談模型，<b>A.I</b> 談行動。每個點是一篇文章。</p></div></div>
      {THREADS.map((t, i) => {
        const first = firstOf(t.key);
        return (
          <div class="step"><div class="card">
            <p class="eyebrow">主線 {i + 1}｜{t.name}</p>
            <p set:html={rich(THREAD_LINES[t.key])} />
            {first && <p><a class="btn small" href={`/a/${first.slug}/`}>讀這條線：{first.title} →</a></p>}
          </div></div>
        );
      })}
    </div>
  </section>

  <section class="section" id="chapters">
    <p class="eyebrow">依章節找文章</p>
    <h2 class="h2">22 篇觀點</h2>
    {CHAPTER_ORDER.map((ch) => (
      <div class={`chgroup ch-${ch}`}>
        <h3><span class="chip">{CHAPTERS[ch].name}</span> {CHAPTERS[ch].zh}</h3>
        <ul>
          {ARTICLES.filter((a) => a.chapter === ch).map((a) => {
            const has = Boolean(STORIES[a.id]);
            return (
              <li>
                <a href={has ? `/a/${a.slug}/` : `/a/${a.slug}/full/`} class:list={{ has }}>
                  {a.kicker && <span class="kick">〈{a.kicker}〉</span>}
                  <b>{a.title}</b>
                  {a.subtitle && <span class="sub">{a.subtitle}</span>}
                  <span class="by">{a.authors.map((x) => x.name).join('、')}｜紙本 p.{a.pages[0]}</span>
                  <em>{has ? '90 秒故事' : `原文約 ${a.minutes} 分鐘`}</em>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
    <p class="source">標題、作者與職稱以文章內頁為準。90 秒故事陸續上線中。</p>
  </section>
</Base>
<style>
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 40px; }
  .actions .scroll-hint { margin-top: 0; }
  .skiplink { font-size: 14px; color: var(--ink-2); }
  .h2 { font-size: clamp(26px, 3vw + 12px, 40px); margin: 4px 0 8px; }
  .btn.small { padding: 8px 14px; font-size: 14px; }
  .chgroup { margin: 28px 0; }
  .chgroup h3 { font-size: 18px; display: flex; gap: 10px; align-items: center; margin: 0 0 10px; }
  .chgroup ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 10px; }
  .chgroup a { display: grid; gap: 3px; align-content: start; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--line); background: var(--paper); text-decoration: none; height: 100%; transition: background .2s; }
  .chgroup a.has { border: 2px solid var(--accent-ink); }
  .chgroup a:hover { background: var(--accent); }
  .chgroup b { font-size: 16px; line-height: 1.45; }
  .kick { font-size: 12px; font-weight: 700; color: var(--accent-ink); }
  .sub { font-size: 13px; color: var(--ink-2); line-height: 1.45; }
  .by { font-size: 12px; color: var(--ink-3); margin-top: 4px; }
  .chgroup em { font-style: normal; font-size: 12px; font-weight: 700; color: var(--accent-ink); }
</style>
