---
// 原文頁。也是「原文視窗」的資料來源：reader.ts 會抓這一頁的 [data-fulltext]，
// 依 data-i（文字區塊編號，與 src/lib/locate.ts 一致）高亮引文。
import Base from '../../../layouts/Base.astro';
import ArticleHead from '../../../components/ArticleHead.astro';
import { ARTICLES, fullTitle, authorNames, CHAPTERS, type Article } from '../../../lib/articles';
import { STORIES } from '../../../data/stories';
import { FULLTEXT_REVIEWED, hasFulltext, loadFulltext } from '../../../lib/fulltext';

export function getStaticPaths() {
  return ARTICLES.filter((a) => hasFulltext(a.id)).map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
interface Props { a: Article }
const { a } = Astro.props;
const reviewed = FULLTEXT_REVIEWED.has(a.id);
let i = 0;
const blocks = loadFulltext(a.id).map((b) => (b.kind === 'page' ? b : { ...b, i: i++ }));
---
<Base title={`原文｜${fullTitle(a)}｜決策智慧 2026`} description={`${fullTitle(a)} 原文全文，標示紙本頁碼。`} chapter={a.chapter} crumb={`${a.title}．原文`} og={`/og/${a.slug}.png`}>
  <article class="full wrap">
    <div class="head">
      <ArticleHead a={a} mode="full" />
      <div class="reader-meta">
        <p>{CHAPTERS[a.chapter].name}｜{authorNames(a)}｜紙本 p.{a.pages[0]}–{a.pages[1]}</p>
        {reviewed
          ? <p>此全文取自刊物的排版原始檔（InDesign），已與印刷版逐頁逐字比對，並經多代理校稿、覆核與隨機抽查；圖表以圖說呈現，引用請以紙本為準。</p>
          : <p>此全文取自刊物的排版原始檔（InDesign），頁碼依 PDF 對照；尚未完成與印刷版的校稿，圖表以圖說呈現，引用請以紙本為準。</p>}
      </div>
      {STORIES[a.id] && <p><a class="btn ghost" href={`/story/${a.slug}/`}>← 回到故事</a></p>}
    </div>
    <div class="fulltext" data-fulltext>
      {blocks.map((b) =>
        b.kind === 'page' ? <p class="pg" id={`p${b.page}`}>紙本 p.{b.page}</p>
        : b.kind === 'h' ? <h2 data-i={b.i}>{b.text}</h2>
        : b.kind === 'cap' ? <p class="cap" data-i={b.i}>{b.text}</p>
        : b.kind === 'box' ? <p class="box" data-i={b.i}>{b.text}</p>
        : b.kind === 'note' ? <p class="note" data-i={b.i}>{b.text}</p>
        : <p data-i={b.i}>{b.text}</p>)}
    </div>
  </article>
</Base>
<style>
  .full { padding-top: 96px; padding-bottom: 12svh; }
  .head { display: grid; gap: 16px; margin-bottom: 48px; }
  .reader-meta { font-size: 13px; color: var(--ink-3); max-width: 46rem; }
  .reader-meta p { margin: 0 0 4px; }
  .fulltext { max-width: var(--measure); font-size: clamp(17px, .6vw + 14px, 19px); line-height: 1.9; }
  .fulltext p { margin: 0 0 1.1em; }
  .fulltext h2 { font-size: 1.25em; line-height: 1.5; margin: 1.8em 0 .6em; }
  .pg { font-family: var(--font-mono); font-size: 12px !important; color: var(--ink-3); border-top: 1px dashed var(--line); padding-top: 6px; margin-top: 2em !important; letter-spacing: .06em; }
</style>
