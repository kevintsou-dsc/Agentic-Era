---
import Base from '../../../layouts/Base.astro';
import ArticleHead from '../../../components/ArticleHead.astro';
import Scenes from '../../../components/Scenes.astro';
import { ARTICLES, THREADS, cite, fullTitle, type Article } from '../../../lib/articles';
import { STORIES } from '../../../data/stories';
import { FULLTEXT_REVIEWED } from '../../../lib/fulltext';
import type { Story } from '../../../lib/story';
import { storyMinutes } from '../../../lib/stats';
import { RELEASE } from '../../../lib/release';
import ReadMap from '../../../components/ReadMap.astro';
import SharePanel from '../../../components/SharePanel.astro';

export function getStaticPaths() {
  return ARTICLES.filter((a) => STORIES[a.id]).map((a) => ({ params: { slug: a.slug }, props: { a, story: STORIES[a.id] } }));
}
interface Props { a: Article; story: Story }
const { a, story } = Astro.props;

const fullReviewed = FULLTEXT_REVIEWED.has(a.id);
// 接下來讀什麼：
// 1. 「下一篇」＝紙本順序的下一篇（有故事的），每頁都有，保證 22 篇能一路讀完；最後一篇沒有。
// 2. 本篇所屬的每一條主線，各給一張「同一條主線」的下一篇；主線的最後一篇不再繞回開頭。與「下一篇」相同的不重複列。
const withStory = ARTICLES.filter((x) => STORIES[x.id]);
const bookNext = withStory[withStory.indexOf(a) + 1];
const threadNext = THREADS.filter((t) => a.threads.includes(t.key))
  .map((t) => {
    const line = withStory.filter((x) => x.threads.includes(t.key));
    return { t, n: line[line.indexOf(a) + 1] };
  })
  .filter((x): x is { t: (typeof THREADS)[number]; n: Article } => !!x.n && x.n !== bookNext);
---
<Base title={`${fullTitle(a)}｜決策智慧 2026`} description={story.oneLiner} chapter={a.chapter} crumb={`${a.title}．精華 ${storyMinutes(story)} 分鐘`} og={`/og/${a.slug}.png`}>
  <section class="hero">
    {!RELEASE && story.status !== 'reviewed' && <p class="draft">{story.status === 'judged' ? 'AI 初評通過・待人工校閱' : '草稿：待審定'}</p>}
    <ArticleHead a={a} mode="story" storyMinutes={`${storyMinutes(story)} 分鐘`} />
    <p class="lede one"><span class="curated">核心一句話</span><br />{story.oneLiner}</p>
    <p class="scroll-hint">往下捲動</p>
  </section>

  <Scenes scenes={story.scenes} chapter={a.chapter} seed={Number(a.id.slice(1))} />

  <section class="section ending">
    <p class="eyebrow reveal">{story.asksTitle ?? '帶走這幾個問題'}</p>
    <ol class:list={['asks', { solo: story.asks.length === 1 }]}>
      {story.asks.map((q, i) => (
        <li class="reveal">
          {story.asksLabels?.[i] && <span class="ask-label">{story.asksLabels[i]}</span>}
          {q.text}<span class="pg">紙本 p.{q.page}</span>
        </li>
      ))}
    </ol>
    <p class="source reveal">原文｜{cite(a)}</p>
  </section>

  <SharePanel a={a} story={story} />

  <nav class="section next" aria-label="接下來">
    <a class="btn flow" href={`/story/${a.slug}/original/`}>讀原文（約 {a.minutes} 分鐘{fullReviewed ? '' : '，校正中'}）→</a>
    {bookNext && (
      <a class="nextcard" href={`/story/${bookNext.slug}/`}>
        <span class="eyebrow">下一篇｜紙本 p.{bookNext.pages[0]}{THREADS.filter((t) => bookNext.threads.includes(t.key) && a.threads.includes(t.key)).map((t) => `・同一條主線「${t.name}」`).join('')}</span>
        <b>{bookNext.title}</b>
        <span>{bookNext.authors.map((x) => x.name).join('、')}｜精華 {storyMinutes(STORIES[bookNext.id])} 分鐘</span>
      </a>
    )}
    {threadNext.map(({ t, n }) => (
      <a class="nextcard thread" href={`/story/${n.slug}/`}>
        <span class="eyebrow">同一條主線｜{t.name}</span>
        <b>{n.title}</b>
        <span>{n.authors.map((x) => x.name).join('、')}｜精華 {storyMinutes(STORIES[n.id])} 分鐘</span>
      </a>
    ))}
    <a class="btn ghost" href="/#chapters">← 回到全書，依章節找文章</a>
  </nav>
  <ReadMap a={a} />
</Base>
<style>
  .one { margin-top: 28px; }
  .draft { justify-self: start; margin: 0 0 12px; padding: 2px 10px; border-radius: 6px; background: var(--model); font-size: 12px; font-weight: var(--fw-bold); }
  .asks { margin: 24px 0 8px; padding-left: 1.4em; display: grid; gap: 18px; font-size: clamp(21px, 2vw + 12px, 32px); font-family: var(--font-serif); font-weight: 700; line-height: 1.45; max-width: 46rem; }
  /* 只有一句時不編號：單獨一個「1.」沒有意義 */
  .asks.solo { list-style: none; padding-left: 0; }
  /* 原文表格的列名（例如「體驗阻力診斷」），讓表格裡的短問句讀得懂在問哪一層 */
  .ask-label { display: block; font-family: var(--font-sans); font-size: var(--fs-meta); font-weight: var(--fw-bold); color: var(--ink-2); letter-spacing: .04em; margin-bottom: 2px; }
  .pg { display: block; font-family: var(--font-sans); font-size: 13px; font-weight: 400; color: var(--ink-3); margin-top: 4px; }
  .next { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; padding-top: 6svh; }
  .nextcard { display: grid; gap: 4px; padding: 16px 20px; border-radius: 14px; border: 2px solid var(--accent-ink); text-decoration: none; background: var(--paper); flex: 1 1 18rem; max-width: 28rem; }
  .nextcard:hover { background: var(--accent); }
  .nextcard.thread { border-style: dashed; }
  .nextcard b { font-size: 18px; }
  .nextcard span:last-child { font-size: 13px; color: var(--ink-2); }
  [aria-disabled="true"] { opacity: .55; cursor: not-allowed; }
</style>
