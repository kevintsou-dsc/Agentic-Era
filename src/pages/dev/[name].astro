---
// 開發用圖形總覽：把所有故事的圖形以「最後一步」狀態並排，方便一次檢查版面。正式建置不會產生這一頁。
import Base from '../../layouts/Base.astro';
import Graphic from '../../components/graphics/Graphic.astro';
import BookDots from '../../components/graphics/BookDots.astro';
import { STORIES } from '../../data/stories';
import { article } from '../../lib/articles';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { name: 'gallery' } }] : [];
}
const items = Object.values(STORIES).flatMap((s) =>
  s.scenes.flatMap((sc, i) => (sc.kind === 'graphic' ? [{ id: s.id, i, g: sc.graphic, steps: sc.steps.length }] : [])),
);
const all = Array.from({ length: 10 }, (_, k) => `is-${k + 1}`).join(' ');
---
<Base title="圖形總覽（開發用）" description="dev">
  <div class="wrap gal">
    <h1>圖形總覽（{items.length + 1} 張，最後一步狀態）</h1>
    <section class={`ch-intro cell`}><p class="tag">首頁 BookDots（step 6）</p><div class={`graphic ${all.split(' ').slice(0, 6).join(' ')}`} data-step="6"><BookDots /></div></section>
    {items.map((it) => (
      <section class={`ch-${article(it.id).chapter} cell`}>
        <p class="tag">{it.id} · 場景 {it.i + 1} · {it.g.type} · {it.steps} 步</p>
        <div class={`graphic ${all}`} data-step={String(it.steps)}><Graphic g={it.g} /></div>
      </section>
    ))}
  </div>
</Base>
<style>
  .gal { padding-top: 80px; display: grid; gap: 28px; }
  .cell { border: 1px dashed var(--line); border-radius: 12px; padding: 16px; }
  .cell .graphic { position: static; height: auto; padding: 0; display: block; }
  .tag { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); margin: 0 0 10px; }
</style>
