---
import Base from '../../layouts/Base.astro';
import Quote from '../../components/Quote.astro';
import DoomLoop from '../../components/graphics/DoomLoop.astro';
import AttentionBars from '../../components/graphics/AttentionBars.astro';
import MediaMatrix from '../../components/graphics/MediaMatrix.astro';
import { ARTICLES, QUOTES } from '../../data/poc';
const a = ARTICLES.a10;
---
<Base title={`${a.short}｜90 秒｜決策智慧 2026`} description="POC C：單篇 90 秒故事。" crumb="C．單篇 90 秒">
  <section class="hero">
    <p class="eyebrow"><span class="chip">People</span>　{a.pages}｜精華約 90 秒｜原文約 {a.minutes} 分鐘</p>
    <h1 class="display">別買曝光了，<br />開始買注意力吧</h1>
    <p class="who">{a.authors}｜{a.role}</p>
    <p class="lede"><span class="curated">一句話｜策展者整理</span><br />曝光正在通膨、注意力正在升值。被看進去、被想起來，才算數。</p>
    <p class="scroll-hint">往下捲動</p>
  </section>

  <section class="scrolly graphic-right">
    <div class="graphic"><DoomLoop /></div>
    <div class="steps">
      <div class="step"><div class="card"><p class="curated">整理：策展者</p><p>預算一再流向能即時量化的成效型格式……</p></div></div>
      <div class="step"><div class="card"><p>……廣告效果卻進入高原期……</p></div></div>
      <div class="step"><div class="card"><p>……於是再依同一套有缺陷的指標優化。</p></div></div>
      <div class="step"><div class="card"><p>結果是成效越優化、品牌越萎縮：<b>The Doom Loop</b>。</p></div></div>
    </div>
  </section>

  <section class="scrolly">
    <div class="graphic"><AttentionBars /></div>
    <div class="steps">
      <div class="step"><div class="card"><p class="curated">整理：策展者</p><p>注意力也分品質。自己選擇看，比被迫看的品牌回想高 <b>18%</b>……</p></div></div>
      <div class="step"><div class="card"><p>……看超過 10 秒，高出 <b>79%</b>。</p><Quote q={QUOTES.cantBuy} /></div></div>
    </div>
  </section>

  <section class="scrolly graphic-right">
    <div class="graphic"><MediaMatrix /></div>
    <div class="steps">
      <div class="step"><div class="card"><p class="curated">整理：策展者</p><p>那預算先押哪裡？作者用兩個問題判斷：消費者是不是都在問同一個問題？你的主張好不好證明？需求分歧又難證明，就先建立<b>品牌主敘事</b>。</p></div></div>
      <div class="step"><div class="card"><p>需求一致但難證明：廣告創造注意、內容完成驗證，<b>雙管齊下</b>。</p></div></div>
      <div class="step"><div class="card"><p>需求分歧但容易證明：拆解情境，<b>各個擊破</b>。</p></div></div>
      <div class="step"><div class="card"><p>需求一致又容易證明：先讓內容成為 AI、搜尋與社群可以引用的<b>答案</b>。</p></div></div>
      <div class="step"><div class="card"><p>現在換你：點矩陣裡任一格，看看你的品牌該怎麼做。</p></div></div>
    </div>
  </section>

  <section class="section ending">
    <p class="eyebrow reveal">帶走三個問題｜原文 紙本 p.78</p>
    <ol class="asks">
      <li class="reveal">{QUOTES.ask1.text}</li>
      <li class="reveal">{QUOTES.ask2.text}</li>
      <li class="reveal">{QUOTES.ask3.text}</li>
    </ol>
  </section>

  <section class="section">
    <div class="next">
      <a class="btn" href="/poc-c">← 回到全書故事</a>
      <span class="btn ghost" aria-disabled="true">讀原文（約 {a.minutes} 分鐘，POC 尚未開放）</span>
    </div>
    <p class="source">這篇也出現在主線「從注意力到記憶」，同線還有：何華軒〈當注意力成為稀缺資源〉、吳宗霖與陳炯文〈從金曲獎到甄嬛傳〉、吳宗霖〈重建 SOV〉。</p>
  </section>
</Base>
<style>
  .who { color: var(--ink-2); font-size: 15px; margin: 0 0 12px; }
  .asks { margin: 24px 0 8px; padding-left: 1.4em; display: grid; gap: 18px; font-size: clamp(22px, 2.2vw + 12px, 34px); font-weight: 800; line-height: 1.4; }
  .next { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
  [aria-disabled="true"] { opacity: .5; cursor: not-allowed; }
</style>
